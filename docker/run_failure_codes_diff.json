  "added": [
    {
      "code": "report_mode_unsupported",
      "collection": "codes",
      "entry": {
        "args": {
          "contract": {
            "kind": "string"
          },
          "mode": {
            "kind": "string"
          }
        },
        "class": "unsupported",
        "description": "The requested report mode cannot be provided for this run. Two causes: the host has no provider bridge for the mode and contract (run_json), or the native kernel refuses a SUMMARY_ONLY run that configures a selected window or an execution observer without a report sink at begin, because that capture has no exact trade rows. Remedy for the second cause: drop the window or the observer, or select FULL; bounded capture uses STREAMED with a sink.",
        "english": [
          "unsupported report mode: {mode} (no {contract} provider bridge for this host)",
          "unsupported report mode: {mode} (a selected window or execution observer cannot be captured exactly under {contract} in this mode: drop it or select FULL; bounded capture uses STREAMED with a sink)"
        ],
        "retryable": false,
        "since": "1.7.0"
      }
    },
    {
      "code": "report_sink_failed",
      "collection": "codes",
      "entry": {
        "args": {
          "arena_bytes": {
            "kind": "integer",
            "optional": true
          },
          "cap_bytes": {
            "kind": "integer",
            "optional": true
          },
          "claimed_bytes": {
            "kind": "integer",
            "optional": true
          },
          "high_water_bytes": {
            "kind": "integer",
            "optional": true
          },
          "needed_bytes_lower_bound": {
            "kind": "integer",
            "optional": true
          },
          "reason": {
            "kind": "vocab",
            "optional": true,
            "values": [
              "arena_exhausted",
              "arena_io",
              "arena_backing",
              "scratch_io",
              "sink_io",
              "sink_peer_closed",
              "sink_exhausted"
            ]
          },
          "sink_bytes": {
            "kind": "integer",
            "optional": true
          },
          "store": {
            "kind": "vocab",
            "optional": true,
            "values": [
              "curve",
              "position_tail",
              "cohort",
              "exit_rank",
              "sequence_index",
              "sequence_index_idx",
              "erased_minima",
              "erased_minima_idx",
              "partial_cycles",
              "partial_cycles_idx",
              "successor_roots",
              "command",
              "unknown"
            ]
          }
        },
        "class": "engine_fault",
        "description": "The engine could not complete the report sink, scratch storage or spill arena. Every reason, including exhaustion of the engine-certified arena bound or planned sink cap and a closed sink peer during finalization, is an engine fault. reason distinguishes arena exhaustion (arena_exhausted), arena I/O (arena_io), invalid arena backing (arena_backing), file-mode scratch I/O (scratch_io), sink open/write I/O (sink_io), a closed sink peer (sink_peer_closed) and a finalizer stream exceeding its planned cap (sink_exhausted). With arena_exhausted, high_water_bytes and arena_bytes are byte counts, claimed_bytes counts chunk bytes claimed when the failing claim was attempted, and store identifies the requesting scratch user. needed_bytes_lower_bound is the requesting report region's additional whole-chunk demand. For store command it is the arena size needed for the required store extent rounded up to chunks, divided by kCommandScratchArenaShare and rounded up to bytes (saturated at INT64_MAX). Crossing a command store's share is arena_exhausted and the hosting layer re-places the run. With sink_exhausted, the finalizer exits 8; sink_bytes is the bytes read (cap_bytes + 1) and cap_bytes is the planned cap U. APP maps that receipt to this failure and refunds the run; COMPUTE re-places it with 2x U. Other reasons carry no sizes or store identity. All arguments are optional for existing raisers; the run has no completed sink or valid trailer.",
        "english": [
          "report sink open failed",
          "report sink write failed",
          "report sink write made no progress"
        ],
        "retryable": false,
        "since": "1.7.0"
      }
    },
    {
      "code": "scratch_capacity_exceeded",
      "collection": "codes",
      "entry": {
        "args": {
          "resource": {
            "kind": "vocab",
            "values": [
              "layout",
              "sequence_data",
              "sequence_index",
              "erased_data",
              "erased_index",
              "consumed_data",
              "consumed_index",
              "cohort",
              "exit_rank",
              "successor_roots"
            ]
          }
        },
        "class": "resource",
        "description": "The admitted scratch-table layout or a fixed region's capacity was exceeded. The run must be admitted with sufficient finite maxima before retrying.",
        "english": [
          "scratch capacity exceeded"
        ],
        "retryable": false,
        "since": "1.7.0"
      }
    },
    {
      "code": "scratch_configuration_invalid",
      "collection": "codes",
      "entry": {
        "args": {
          "reason": {
            "kind": "vocab",
            "values": [
              "nondecimal",
              "nonpositive",
              "overflow"
            ]
          },
          "stage": {
            "kind": "vocab",
            "values": [
              "command_scratch_byte_cap"
            ]
          }
        },
        "class": "input",
        "description": "The command-scratch byte cap from the environment or the caller is malformed: not a positive decimal, out of uint64_t range, or zero.",
        "english": [
          "command scratch byte cap is not positive decimal uint64_t"
        ],
        "retryable": false,
        "since": "1.7.0"
      }
    },
    {
      "code": "scratch_io_failed",
      "collection": "codes",
      "entry": {
        "args": {},
        "class": "resource",
        "description": "The engine could not create, resize, read or write the storage of one of its auxiliary tables (the disk id table, the id-pair store or the placement table). The run has no successful completion. Report-sink scratch files, the curve writer and the position-tail facade do not raise this code: they raise report_sink_failed with reason scratch_io.",
        "english": [
          "scratch create",
          "scratch read",
          "scratch write",
          "id table create",
          "id table resize",
          "id table read",
          "id table write"
        ],
        "retryable": false,
        "since": "1.7.0"
      }
    }
  ],
