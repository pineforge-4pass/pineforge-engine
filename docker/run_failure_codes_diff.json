      "code": "pine_map_capacity_exceeded",
      "collection": "codes",
      "entry": {
        "args": {
          "bar_index": {
            "kind": "integer"
          },
          "code": {
            "kind": "identifier"
          },
          "currSize": {
            "kind": "integer"
          },
          "maxSize": {
            "kind": "integer"
          }
        },
        "class": "strategy_limit",
        "description": "A distinct map insertion exceeds that map's configured pair limit. Zero or omitted selects no limit. Counts and bar index are engine-owned context; code is the fixed TradingView identifier RE10070.",
        "english": [
          "Error on bar {bar_index}: A map cannot have more than {maxSize} key-value pairs. The current size is {currSize}."
        ],
        "retryable": false,
        "since": "1.11.0"
      }
    },
    {
      "code": "runtime_history_budget_exhausted",
      "collection": "codes",
      "entry": {
        "args": {
          "configured": {
            "kind": "string"
          },
          "needed": {
            "kind": "string"
          },
          "used": {
            "kind": "string"
          }
        },
        "class": "resource",
        "description": "A reached dynamic runtime context exceeded its explicitly configured history storage budget. configured, used and needed are the typed exception's exact uint64_t byte fields: the configured bound, ownership before the refused operation, and its additional required ownership. Each is a canonical unsigned decimal string from 0 through 18446744073709551615, without a sign, whitespace or leading zeroes except 0 itself. These counters do not use the host run-quota domain. No budget is imposed by the resident spill threshold or by the default absent budget.",
        "english": [
          "runtime_history_budget_exhausted: configured={configured} used={used} needed={needed}"
        ],
        "retryable": false,
        "since": "1.10.1"
      }
    },
    {
      "code": "runtime_storage_observation_incomplete",
      "collection": "codes",
      "entry": {
        "args": {
          "backing_bytes_lower_bound": {
            "kind": "string"
          },
          "overflow": {
            "kind": "boolean"
          },
          "resident_metadata_bytes_lower_bound": {
            "kind": "string"
          },
          "resident_payload_bytes_lower_bound": {
            "kind": "string"
          },
          "unsupported_flags": {
            "kind": "string"
          }
        },
        "class": "unsupported",
        "description": "A hard runtime history budget could not be enforced because the owned storage observation is incomplete. unsupported_flags is the actual uint64_t unsupported bit mask, including unknown bits. resident_metadata_bytes_lower_bound, resident_payload_bytes_lower_bound and backing_bytes_lower_bound are the observed category lower bounds, never an exact or usable total; categories can be saturated when overflow is true. These four uint64_t fields are canonical unsigned decimal strings from 0 through 18446744073709551615, without a sign, whitespace or leading zeroes except 0 itself. overflow is the observation's actual Boolean. No configured, used or needed byte count is inferred from an incomplete observation, even with a UINT64_MAX budget.",
        "english": [
          "runtime context owned storage observation is incomplete"
        ],
        "retryable": false,
        "since": "1.10.1"
      }
    }
  ],
