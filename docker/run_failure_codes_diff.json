  "added": [
    {
      "code": "report_sink_failed",
      "collection": "codes",
      "entry": {
        "args": {
          "arena_bytes": {
            "kind": "integer",
            "optional": true
          },
          "cap_bytes": {
            "kind": "integer",
            "optional": true
          },
          "claimed_bytes": {
            "kind": "integer",
            "optional": true
          },
          "high_water_bytes": {
            "kind": "integer",
            "optional": true
          },
          "needed_bytes_lower_bound": {
            "kind": "integer",
            "optional": true
          },
          "reason": {
            "kind": "vocab",
            "optional": true,
            "values": [
              "arena_exhausted",
              "arena_io",
              "arena_backing",
              "scratch_io",
              "sink_io",
              "sink_peer_closed",
              "sink_exhausted"
            ]
          },
          "sink_bytes": {
            "kind": "integer",
            "optional": true
          },
          "store": {
            "kind": "vocab",
            "optional": true,
            "values": [
              "curve",
              "position_tail",
              "cohort",
              "exit_rank",
              "sequence_index",
              "sequence_index_idx",
              "erased_minima",
              "erased_minima_idx",
              "partial_cycles",
              "partial_cycles_idx",
              "successor_roots",
              "unknown"
            ]
          }
        },
        "class": "engine_fault",
        "description": "The engine could not complete the report sink, scratch storage or spill arena. Every reason, including exhaustion of the engine-certified arena bound or planned sink cap and a closed sink peer during finalization, is an engine fault. reason distinguishes arena exhaustion (arena_exhausted), arena I/O (arena_io), invalid arena backing (arena_backing), file-mode scratch I/O (scratch_io), sink open/write I/O (sink_io), a closed sink peer (sink_peer_closed) and a finalizer stream exceeding its planned cap (sink_exhausted). With arena_exhausted, high_water_bytes and arena_bytes are byte counts, claimed_bytes counts chunk bytes claimed when the failing claim was attempted, store identifies the requesting scratch user, and needed_bytes_lower_bound is the least additional arena bytes needed to satisfy the failed request. With sink_exhausted, the finalizer exits 8; sink_bytes is the bytes read (cap_bytes + 1) and cap_bytes is the planned cap U. APP maps that receipt to this failure and refunds the run; COMPUTE re-places it with 2x U. Other reasons carry no sizes or store identity. All arguments are optional for existing raisers; the run has no completed sink or valid trailer.",
        "english": [
          "report sink open failed",
          "report sink write failed",
          "report sink write made no progress"
        ],
        "retryable": false,
        "since": "1.7.0"
      }
    }
  ],
