# Invoked only after the shipped executable has been installed.
set(_pf_sa_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_pf_sa_binary "${_pf_sa_root}/${PF_SA_HELPER_PATH}")
if(NOT EXISTS "${_pf_sa_binary}" OR IS_DIRECTORY "${_pf_sa_binary}")
    message(FATAL_ERROR "Installed pineforge-selected-admit is missing: ${_pf_sa_binary}")
endif()
file(SIZE "${_pf_sa_binary}" _pf_sa_size)
file(SHA256 "${_pf_sa_binary}" _pf_sa_sha)

# Byte lookup and UTF-8 decoding keep the JSON identical to the C++ ASCII
# encoder without depending on a newer CMake JSON implementation.
function(_pf_sa_octet text index result)
    string(SUBSTRING "${text}" ${index} 1 _pf_sa_byte)
    foreach(_pf_sa_number RANGE 1 255)
        string(ASCII ${_pf_sa_number} _pf_sa_character)
        string(COMPARE EQUAL "${_pf_sa_character}" "${_pf_sa_byte}" _pf_sa_same)
        if(_pf_sa_same)
            set(${result} ${_pf_sa_number} PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Invalid UTF-8 in helper manifest metadata")
endfunction()

function(_pf_sa_unit point result)
    set(_pf_sa_hex "0123456789abcdef")
    set(_pf_sa_text "\\u")
    foreach(_pf_sa_shift 12 8 4 0)
        math(EXPR _pf_sa_digit "(${point} >> ${_pf_sa_shift}) & 15")
        string(SUBSTRING "${_pf_sa_hex}" ${_pf_sa_digit} 1 _pf_sa_character)
        string(APPEND _pf_sa_text "${_pf_sa_character}")
    endforeach()
    set(${result} "${_pf_sa_text}" PARENT_SCOPE)
endfunction()

function(_pf_sa_quote result text)
    string(LENGTH "${text}" _pf_sa_length)
    set(_pf_sa_at 0)
    set(_pf_sa_json "\"")
    while(_pf_sa_at LESS _pf_sa_length)
        _pf_sa_octet("${text}" ${_pf_sa_at} _pf_sa_point)
        string(SUBSTRING "${text}" ${_pf_sa_at} 1 _pf_sa_character)
        math(EXPR _pf_sa_at "${_pf_sa_at} + 1")
        if(_pf_sa_point EQUAL 34 OR _pf_sa_point EQUAL 92)
            string(APPEND _pf_sa_json "\\${_pf_sa_character}")
        elseif(_pf_sa_point GREATER_EQUAL 32 AND _pf_sa_point LESS 127)
            string(APPEND _pf_sa_json "${_pf_sa_character}")
        else()
            if(_pf_sa_point GREATER_EQUAL 128)
                if(_pf_sa_point GREATER_EQUAL 194 AND _pf_sa_point LESS 224)
                    set(_pf_sa_tails 1)
                    set(_pf_sa_minimum 128)
                elseif(_pf_sa_point GREATER_EQUAL 224 AND _pf_sa_point LESS 240)
                    set(_pf_sa_tails 2)
                    set(_pf_sa_minimum 2048)
                elseif(_pf_sa_point GREATER_EQUAL 240 AND _pf_sa_point LESS_EQUAL 244)
                    set(_pf_sa_tails 3)
                    set(_pf_sa_minimum 65536)
                else()
                    message(FATAL_ERROR "Invalid UTF-8 in helper manifest metadata")
                endif()
                math(EXPR _pf_sa_point "${_pf_sa_point} & ((1 << (6 - ${_pf_sa_tails})) - 1)")
                foreach(_pf_sa_tail RANGE 1 ${_pf_sa_tails})
                    if(NOT _pf_sa_at LESS _pf_sa_length)
                        message(FATAL_ERROR "Truncated UTF-8 in helper manifest metadata")
                    endif()
                    _pf_sa_octet("${text}" ${_pf_sa_at} _pf_sa_next)
                    if(_pf_sa_next LESS 128 OR _pf_sa_next GREATER 191)
                        message(FATAL_ERROR "Invalid UTF-8 in helper manifest metadata")
                    endif()
                    math(EXPR _pf_sa_point "(${_pf_sa_point} << 6) | (${_pf_sa_next} & 63)")
                    math(EXPR _pf_sa_at "${_pf_sa_at} + 1")
                endforeach()
                if(_pf_sa_point LESS _pf_sa_minimum OR _pf_sa_point GREATER 1114111
                    OR (_pf_sa_point GREATER_EQUAL 55296 AND _pf_sa_point LESS_EQUAL 57343))
                    message(FATAL_ERROR "Invalid UTF-8 in helper manifest metadata")
                endif()
            endif()
            if(_pf_sa_point GREATER 65535)
                math(EXPR _pf_sa_point "${_pf_sa_point} - 65536")
                math(EXPR _pf_sa_high "55296 + (${_pf_sa_point} >> 10)")
                math(EXPR _pf_sa_low "56320 + (${_pf_sa_point} & 1023)")
                _pf_sa_unit(${_pf_sa_high} _pf_sa_encoded_high)
                _pf_sa_unit(${_pf_sa_low} _pf_sa_encoded_low)
                string(APPEND _pf_sa_json "${_pf_sa_encoded_high}${_pf_sa_encoded_low}")
            else()
                _pf_sa_unit(${_pf_sa_point} _pf_sa_encoded)
                string(APPEND _pf_sa_json "${_pf_sa_encoded}")
            endif()
        endif()
    endwhile()
    string(APPEND _pf_sa_json "\"")
    set(${result} "${_pf_sa_json}" PARENT_SCOPE)
endfunction()

_pf_sa_quote(_pf_sa_path_json "${PF_SA_HELPER_PATH}")
_pf_sa_quote(_pf_sa_full_json "${PF_SA_VERSION_FULL}")
_pf_sa_quote(_pf_sa_version_json "${PF_SA_VERSION}")
_pf_sa_quote(_pf_sa_git_json "${PF_SA_GIT_SHA}")
if(PF_SA_DIRTY)
    set(_pf_sa_dirty_json true)
else()
    set(_pf_sa_dirty_json false)
endif()
set(_pf_sa_manifest "{\"schema\":\"pineforge-selected-capacity-helper-manifest/v1\",")
string(APPEND _pf_sa_manifest "\"helper\":{\"name\":\"pineforge-selected-admit\",\"path\":${_pf_sa_path_json},\"bytes\":\"${_pf_sa_size}\",\"sha256\":\"${_pf_sa_sha}\"},")
string(APPEND _pf_sa_manifest "\"engine\":{\"version_full\":${_pf_sa_full_json},\"version\":${_pf_sa_version_json},\"git_sha\":${_pf_sa_git_json},\"dirty\":${_pf_sa_dirty_json}},")
string(APPEND _pf_sa_manifest "\"descriptor\":{\"request_schema\":\"pineforge-selected-capacity-request/v1\",\"result_schema\":\"pineforge-selected-capacity-result/v1\",\"spec_sha256\":\"${PF_SA_SPEC_SHA256}\"},")
string(APPEND _pf_sa_manifest "\"failure_catalog\":{\"codes\":[\"selected_auxiliary_rows_limit_exceeded\",\"selected_bytes_limit_exceeded\",\"selected_primary_rows_limit_exceeded\",\"selected_script_bars_limit_exceeded\",\"selected_source_rows_limit_exceeded\"],\"catalog_sha256\":\"${PF_SA_CATALOG_SHA256}\"},")
string(APPEND _pf_sa_manifest "\"stages\":${PF_SA_STAGES_JSON}}\n")
set(_pf_sa_manifest_file "${_pf_sa_root}/${PF_SA_MANIFEST_PATH}")
get_filename_component(_pf_sa_manifest_directory "${_pf_sa_manifest_file}" DIRECTORY)
file(MAKE_DIRECTORY "${_pf_sa_manifest_directory}")
file(WRITE "${_pf_sa_manifest_file}" "${_pf_sa_manifest}")
