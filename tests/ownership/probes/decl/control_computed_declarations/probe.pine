//@version=6
strategy("control_computed_declarations", default_qty_type=strategy.fixed, default_qty_value=math.pow(10, 400), margin_long=-math.pow(10, 400), margin_short=1 + 1, initial_capital=math.pow(10, 400), commission_value=math.pow(10, 400))

if bar_index == 0
    strategy.entry("L", strategy.long, qty=1)
if bar_index == 3
    strategy.close("L")
