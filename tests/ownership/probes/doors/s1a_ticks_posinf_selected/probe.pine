//@version=6
strategy("s1a_ticks_posinf_selected", initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=2)
if bar_index == 2
    strategy.exit("X", from_entry="L", loss=math.exp(close * 100.0))
if bar_index == 3
    strategy.entry("W", strategy.long, qty=1)
if bar_index == 5
    strategy.close_all()
