//@version=6
strategy("s1a_price_posinf_earlier", initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=2)
if bar_index == 0
    strategy.entry("P", strategy.long, qty=na, limit=math.exp(close * 100.0))
if bar_index == 3
    strategy.entry("W", strategy.long, qty=1)
if bar_index == 5
    strategy.close_all()
