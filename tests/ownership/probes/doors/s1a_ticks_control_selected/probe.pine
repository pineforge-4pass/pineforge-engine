//@version=6
strategy("s1a_ticks_control_selected", initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=2)
if bar_index == 2
    strategy.exit("X", from_entry="L", profit=na, loss=na, trail_points=na, trail_offset=na, trail_price=na)
if bar_index == 3
    strategy.entry("W", strategy.long, qty=1)
if bar_index == 5
    strategy.close_all()
