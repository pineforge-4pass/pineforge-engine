//@version=6
strategy("EN-132 entry_stop_directional_finite", initial_capital=1000000, default_qty_type=strategy.percent_of_equity, default_qty_value=1, margin_long=0, margin_short=0, commission_value=0, slippage=0, calc_on_order_fills=true)
if bar_index == 0
    strategy.entry("raw", strategy.long, stop=1e296)
if bar_index == 3
    strategy.cancel_all()
    strategy.close_all()
