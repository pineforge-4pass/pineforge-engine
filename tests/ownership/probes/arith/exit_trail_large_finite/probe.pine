//@version=6
strategy("EN-132 exit_trail_large_finite", initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0, commission_value=0, slippage=0)
if bar_index == 0
    strategy.entry("E", strategy.long, qty=1)
if bar_index == 1
    strategy.exit("trail", "E", trail_points=1e300, trail_offset=1)
if bar_index == 3
    strategy.cancel_all()
    strategy.close_all()
