//@version=6
strategy("Ownership risk max_intraday_filled_orders_valid", initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1)

if bar_index == 0
    strategy.risk.max_intraday_filled_orders(4)

if bar_index == 5
    strategy.entry("L", strategy.long, qty=1.0)
if bar_index == 10
    strategy.close("L")
