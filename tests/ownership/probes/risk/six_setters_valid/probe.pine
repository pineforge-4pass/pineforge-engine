//@version=6
strategy("Ownership risk six_setters_valid", initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1)

if bar_index == 0
    strategy.risk.allow_entry_in(strategy.direction.long)
    strategy.risk.max_cons_loss_days(3)
    strategy.risk.max_drawdown(25.0, strategy.percent_of_equity)
    strategy.risk.max_intraday_loss(25.0, strategy.percent_of_equity)
    strategy.risk.max_intraday_filled_orders(4)
    strategy.risk.max_position_size(7.0)

if bar_index == 5
    strategy.entry("L", strategy.long, qty=1.0)
if bar_index == 10
    strategy.close("L")
