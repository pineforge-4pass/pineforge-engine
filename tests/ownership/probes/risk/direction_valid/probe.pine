//@version=6
strategy("Ownership risk direction_valid", initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1)

if bar_index == 0
    strategy.risk.allow_entry_in(strategy.direction.long)

if bar_index == 5
    strategy.entry("L", strategy.long, qty=1.0)
if bar_index == 10
    strategy.close("L")
