//@version=6
strategy("Ownership risk max_position_size_earlier_preroll_neg_inf", initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1)

float riskValue = -math.exp(close * 10.0)
if bar_index == 0
    strategy.risk.max_position_size(riskValue)

if bar_index == 5
    strategy.entry("L", strategy.long, qty=1.0)
if bar_index == 10
    strategy.close("L")
