//@version=6
strategy("EN132 sizing_equity_nonfinite", initial_capital=1e100, default_qty_type=strategy.percent_of_equity, default_qty_value=1, pyramiding=2, margin_long=0, margin_short=0, commission_type=strategy.commission.percent, commission_value=0, slippage=0)
if bar_index == 1
    strategy.entry("seed", strategy.long, qty=1e200)
if bar_index == 6
    strategy.entry("derived", strategy.long)
