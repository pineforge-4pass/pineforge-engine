//@version=6
strategy("EN132 sizing_zero_equity", initial_capital=900, default_qty_type=strategy.percent_of_equity, default_qty_value=100, pyramiding=2, margin_long=0, margin_short=0, commission_type=strategy.commission.percent, commission_value=0, slippage=0)
if bar_index == 1
    strategy.entry("seed", strategy.long, qty=10)
if bar_index == 6
    strategy.entry("zero", strategy.long)
if bar_index == 8
    strategy.close("seed")
