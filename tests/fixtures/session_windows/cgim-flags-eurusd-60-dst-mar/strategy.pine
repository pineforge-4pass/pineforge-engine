// CG-ISMARKET: which session.* flags does TradingView set on each chart bar?
// process_orders_on_close=true: every bar reverses the position at its own
// close, so every trade's ENTRY is one chart bar (TradingView dates a
// process_orders_on_close fill at the bar's open) and the entry's Signal (its
// comment) carries the flags TradingView evaluated on that bar, a letter and a
// digit each: M session.ismarket, P session.ispremarket, Q session.ispostmarket,
// F session.isfirstbar, L session.islastbar, f session.isfirstbar_regular,
// l session.islastbar_regular (1 true, 0 false).
//@version=6
strategy("CG-ISMARKET session flags", overlay=true, initial_capital=1000000000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     commission_type=strategy.commission.percent, commission_value=0, slippage=0,
     process_orders_on_close=true, margin_long=100, margin_short=100)

bit(bool x) => x ? "1" : "0"
flag = "M" + bit(session.ismarket) + "P" + bit(session.ispremarket) + "Q" + bit(session.ispostmarket)
     + "F" + bit(session.isfirstbar) + "L" + bit(session.islastbar)
     + "f" + bit(session.isfirstbar_regular) + "l" + bit(session.islastbar_regular)
if bar_index % 2 == 0
    strategy.entry("L" + flag, strategy.long, comment=flag)
else
    strategy.entry("S" + flag, strategy.short, comment=flag)
