//@version=6
strategy("W3 F02 g8 POOC loop entries, close the first id", overlay=true, pyramiding=5, process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1)

// Lane W3-ENG-EXIT-ALLOC, family F02: strategy.close(id) under the default
// FIFO close_entries_rule once other closes have consumed the id's lots.
// Every cell runs on 2025-04-08, 04-09 and 04-10 (UTC); a cleanup close_all
// ends each day's cell at 05:00.
// One strategy.entry call site, in a loop, enters L1, L2 and L3 (one unit
// each) on the 00:00 bar. At 02:00 close("L3") takes, FIFO, the L1 lot; at
// 03:00 another call site closes "L1".

cell(h, m) => (dayofmonth(time, "UTC") == 8 or dayofmonth(time, "UTC") == 9 or dayofmonth(time, "UTC") == 10) and month(time, "UTC") == 4 and year(time, "UTC") == 2025 and hour(time, "UTC") == h and minute(time, "UTC") == m

if cell(0, 0)
    for i = 1 to 3
        strategy.entry("L" + str.tostring(i), strategy.long, qty=1, comment="L" + str.tostring(i))
if cell(2, 0)
    strategy.close("L3", comment="close L3")
if cell(3, 0)
    strategy.close("L1", comment="close L1")

if cell(5, 0)
    strategy.close_all(comment="cleanup")
