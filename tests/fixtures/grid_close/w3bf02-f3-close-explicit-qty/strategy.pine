//@version=6
strategy("W3B F02 f3 close(id, qty) books its quantity", overlay=true, pyramiding=200, process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1)

// Lane W3B-ENG-GRID, family F02: does strategy.close(id, qty=q) use up q of
// its id's close ledger? BINANCE:ETHUSDT.P 15 bars from 2025-04-08 00:00 UTC,
// one step per 15 minutes. Entries A 0.1, B 0.2, C 0.3; close("B", qty=0.1)
// at step 3; then close("B") at step 5, close("A") at step 7 and close("C")
// at step 9, each at its own call site. A cleanup close_all runs at step 20.

start = timestamp("UTC", 2025, 4, 8, 0, 0)
step = (time - start) / (15 * 60 * 1000)

if step == 0
    strategy.entry("A", strategy.long, qty=0.1, comment="BUY_A")
if step == 1
    strategy.entry("B", strategy.long, qty=0.2, comment="BUY_B")
if step == 2
    strategy.entry("C", strategy.long, qty=0.3, comment="BUY_C")
if step == 3
    strategy.close("B", qty=0.1, comment="PART_B")
if step == 5
    strategy.close("B", comment="SOLE_B")
if step == 7
    strategy.close("A", comment="SOLE_A")
if step == 9
    strategy.close("C", comment="SOLE_C")
if step == 20
    strategy.close_all(comment="cleanup")
