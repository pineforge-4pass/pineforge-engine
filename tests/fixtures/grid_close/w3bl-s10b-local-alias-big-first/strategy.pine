//@version=6
strategy("W3B legacy S10b three-call site after alias sites, big first", overlay=true, pyramiding=10, process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1)

// Lane W3B-ENG-GRID: a replay of strategy.entry / strategy.close / strategy.order
// commands on BINANCE:ETHUSDT.P 15 bars from 2025-04-08 00:00 UTC, one step per
// 15 minutes. Entries go through one strategy.entry call site in a loop; each
// strategy.close call site is a loop of its own, so the calls one site makes on a
// step are that site's calls. A cleanup close_all runs at step 20.

start = timestamp("UTC", 2025, 4, 8, 0, 0)
step = (time - start) / (15 * 60 * 1000)

if step == 0
    strategy.entry("F_SMALL", strategy.long, qty=0.6, comment="BUY_F_SMALL")
    strategy.entry("B", strategy.long, qty=0.6, comment="BUY_B")
    strategy.entry("F_BIG", strategy.long, qty=1, comment="BUY_F_BIG")
    strategy.entry("C", strategy.long, qty=1, comment="BUY_C")
if step == 2
    strategy.entry("B", strategy.long, qty=0.4, comment="BUY_B")
if step == 4
    strategy.entry("D", strategy.long, qty=4, comment="BUY_D")
if step == 5
    strategy.order("trim", strategy.short, qty=2.0000000000000004, comment="TRIM")
var s1Step = array.from(3, 3, 6, 6, 6)
var s1Id = array.from("F_BIG", "B", "B", "C", "D")
var s1Comment = array.from("SETUP_BIG_FIRST", "SETUP_BIG_B", "FIRST_B", "MIDDLE_C", "SURVIVOR_D")
if time >= start
    for k = 0 to array.size(s1Step) - 1
        if array.get(s1Step, k) == step
            strategy.close(array.get(s1Id, k), comment=array.get(s1Comment, k))
var s2Step = array.from(1, 1)
var s2Id = array.from("F_SMALL", "B")
var s2Comment = array.from("SETUP_SMALL_FIRST", "SETUP_SMALL_B")
if time >= start
    for k = 0 to array.size(s2Step) - 1
        if array.get(s2Step, k) == step
            strategy.close(array.get(s2Id, k), comment=array.get(s2Comment, k))

if step == 20
    strategy.close_all(comment="cleanup")
