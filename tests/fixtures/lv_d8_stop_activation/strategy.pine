//@version=6
strategy("LV D8 stop activation", initial_capital=100000, pyramiding=0, default_qty_type=strategy.percent_of_equity, default_qty_value=100)
isLong = input.bool(true, "Long")
kind = input.string("stop", "Kind")
reissue = input.bool(false, "Reissue")
level = isLong ? 101.0 : 99.0
if bar_index == 1 or (reissue and bar_index == 2)
    if kind == "limit"
        strategy.entry("Entry", isLong ? strategy.long : strategy.short, limit=level)
    else if kind == "stop-limit"
        strategy.entry("Entry", isLong ? strategy.long : strategy.short, stop=level, limit=level)
    else if kind == "exit-stop"
        strategy.entry("Entry", isLong ? strategy.long : strategy.short)
        strategy.exit("Exit", "Entry", stop=isLong ? 99.0 : 101.0)
    else
        strategy.entry("Entry", isLong ? strategy.long : strategy.short, stop=level)
