strategy("pxgrid-H-L-stp-K2r-cf", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1, calc_on_order_fills=true, process_orders_on_close=false)
var T = array.from(1743515100000.0, 1743613200000.0, 1744134300000.0, 1744211700000.0, 1744914600000.0, 1745343000000.0, 1745423100000.0, 1746194400000.0, 1746549000000.0, 1746630000000.0, 1747929600000.0, 1748439000000.0, 1748617200000.0, 1749663000000.0, 1750095000000.0, 1750257900000.0, 1751304600000.0, 1751386500000.0, 1751981400000.0, 1752760800000.0, 1753110000000.0, 1753369200000.0, 1753974000000.0, 1754064000000.0, 1754661600000.0, 1756475100000.0, 1758123000000.0, 1759757400000.0, 1760710500000.0, 1761578100000.0, 1762882200000.0, 1763662500000.0)
var V = array.from(9.893, 10.2, 8.83, 8.553, 9.62, 9.56, 9.753, 10.29, 10.41, 10.273, 10.43, 10.2, 10.343, 10.67, 10.62, 10.443, 10.73, 11.29, 11.663, 11.12, 11.35, 11.323, 10.95, 10.76, 11.307, 11.737, 11.737, 12.627, 11.877, 13.357, 13.397, 12.517)
sig = array.indexof(T, float(time))
ev = array.indexof(T, float(time[1]))
strategy.order("Z", strategy.short, qty=1, stop=1.0)
if strategy.position_size == 0 and sig >= 0
