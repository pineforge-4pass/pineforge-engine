//@version=6
strategy("w8e-t3-same-id-add-cover", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=2)
T(h, m) => timestamp("UTC", 2025, 4, 1, h, m)
if time == T(11, 30)
    strategy.entry("A", strategy.long, qty=1)
    strategy.exit("AX", from_entry="A", qty=1, limit=1869.55, stop=1800.0)
if time == T(12, 0)
    strategy.entry("A", strategy.long, qty=1)
if time == T(13, 30)
    strategy.close_all()
