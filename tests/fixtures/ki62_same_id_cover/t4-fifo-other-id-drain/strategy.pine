//@version=6
strategy("w8e-t4-fifo-other-id-drain", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=2)
T(h, m) => timestamp("UTC", 2025, 4, 1, h, m)
if time == T(11, 30)
    strategy.entry("A", strategy.long, qty=1)
if time == T(12, 0)
    strategy.entry("B", strategy.long, qty=2)
    strategy.exit("BT1", from_entry="B", qty=1, limit=1869.75, stop=1800.0)
    strategy.exit("BT2", from_entry="B", qty=1, limit=1950.0, stop=1800.0)
if time == T(13, 30)
    strategy.close_all()
