//@version=6
strategy("Whole-lot all-in reversals", initial_capital=10001.149999999996, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
if bar_index == 0
    strategy.entry("held", strategy.long, qty=99)
if bar_index == 3
    strategy.entry("reverse", strategy.short)
    strategy.close("held")
if bar_index == 6
    strategy.close_all()
