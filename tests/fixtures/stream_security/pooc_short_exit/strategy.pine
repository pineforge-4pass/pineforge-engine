//@version=6
strategy("Closing short brackets", process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0)
if strategy.position_size == 0
    strategy.entry("S", strategy.short)
if strategy.position_size < 0
    strategy.exit("X", "S", stop=high, limit=low)
