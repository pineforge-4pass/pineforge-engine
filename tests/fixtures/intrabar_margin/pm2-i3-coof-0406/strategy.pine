// R5 lane PAR-MARGIN-2 (item 3 under calc_on_order_fills): one leveraged long (margin 20, 4.657 x equity)
// placed on the signal bar 2025-04-06 20:00 UTC, filled at the next bar's open and carried into a bar that
// first crosses the maintenance line at an early 1-minute low and reaches a deeper low later.
// Magnifier ON, calc_on_order_fills ON. Timeout close 3 bars after the entry bar.
//@version=6
strategy("pm2-i3-coof-0406", overlay=true, initial_capital=1000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     margin_long=20, margin_short=20, commission_value=0, slippage=0,
     process_orders_on_close=false, calc_on_order_fills=true, use_bar_magnifier=true)
if time == timestamp("UTC", 2025, 4, 6, 20, 0) and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty = math.floor(4.657 * strategy.equity / close * 1000) / 1000)
if strategy.position_size > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= 3
    strategy.close("L", comment="timeout")
