// H-MEASURE M16 NYSE:F long zero-offset trail, next open ON the carried best (H-MEASURE research, group orders, row M16 / G2-18).
// strategy.exit(trail_points=n, trail_offset=0) is issued at the close of the bar
// whose open filled the entry, and that close has ALREADY reached the activation
// (on its tick). The next bar opens exactly ON the carried best (the close, or the
// activation when the close only reaches it on its tick) and moves favourably
// first to a new extreme. A touch at the open exits there at the carried best; a
// zero-distance ride exits only after the new extreme. Events (UTC):
//   2025-05-06 15:45 -> fill 2025-05-06 16:00  trail_points 3  carried best 10.500
//   2025-05-21 19:15 -> fill 2025-05-21 19:30  trail_points 3  carried best 10.510
//   2025-05-30 13:45 -> fill 2025-05-30 14:00  trail_points 7  carried best 10.330
//   2025-06-05 14:00 -> fill 2025-06-05 14:15  trail_points 3  carried best 10.155
//   2025-06-09 13:30 -> fill 2025-06-09 13:45  trail_points 4  carried best 10.430
//   2025-06-23 14:00 -> fill 2025-06-23 14:15  trail_points 4  carried best 10.690
//   2025-07-22 15:00 -> fill 2025-07-22 15:15  trail_points 7  carried best 11.220
//   2025-08-19 14:00 -> fill 2025-08-19 14:15  trail_points 4  carried best 11.710
//@version=6
strategy("H-MEASURE M16 NYSE:F long zero-offset trail, next open ON the carried best", overlay=true, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=100, pyramiding=1,
     commission_type=strategy.commission.percent, commission_value=0, slippage=0,
     process_orders_on_close=false, margin_long=100, margin_short=100)

var float pts = na
if strategy.position_size == 0
    if time == timestamp("UTC", 2025, 5, 6, 15, 45)
        pts := 3
        strategy.entry("L", strategy.long)
    else if time == timestamp("UTC", 2025, 5, 21, 19, 15)
        pts := 3
        strategy.entry("L", strategy.long)
    else if time == timestamp("UTC", 2025, 5, 30, 13, 45)
        pts := 7
        strategy.entry("L", strategy.long)
    else if time == timestamp("UTC", 2025, 6, 5, 14, 0)
        pts := 3
        strategy.entry("L", strategy.long)
    else if time == timestamp("UTC", 2025, 6, 9, 13, 30)
        pts := 4
        strategy.entry("L", strategy.long)
    else if time == timestamp("UTC", 2025, 6, 23, 14, 0)
        pts := 4
        strategy.entry("L", strategy.long)
    else if time == timestamp("UTC", 2025, 7, 22, 15, 0)
        pts := 7
        strategy.entry("L", strategy.long)
    else if time == timestamp("UTC", 2025, 8, 19, 14, 0)
        pts := 4
        strategy.entry("L", strategy.long)

// The exit is issued once, at the close of the bar whose open filled the entry.
if strategy.position_size > 0 and strategy.opentrades.entry_bar_index(0) == bar_index
    strategy.exit("LX", "L", trail_points=pts, trail_offset=0)

if strategy.position_size > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= 25
    strategy.close("L", comment="timeout")
