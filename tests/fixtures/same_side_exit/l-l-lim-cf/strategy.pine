//@version=6
strategy("pxsame-L-l-lim-cf", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=2, calc_on_order_fills=true, process_orders_on_close=false)
if strategy.position_size == 0
    strategy.cancel("A")
    strategy.entry("L", strategy.long, qty=1)
else if strategy.position_size > 0
    strategy.entry("A", strategy.long, qty=1, limit=1.0)
    strategy.exit("X", loss=5)
