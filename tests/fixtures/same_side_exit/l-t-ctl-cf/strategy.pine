//@version=6
strategy("pxsame-L-t-ctl-cf", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=2, calc_on_order_fills=true, process_orders_on_close=false)
if strategy.position_size == 0
    strategy.entry("L", strategy.long, qty=1)
else if strategy.position_size > 0
    strategy.exit("X", trail_points=5, trail_offset=2)
