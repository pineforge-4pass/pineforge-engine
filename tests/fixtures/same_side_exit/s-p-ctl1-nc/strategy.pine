//@version=6
strategy("pxsame-S-p-ctl1-nc", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1, calc_on_order_fills=false, process_orders_on_close=false)
if strategy.position_size == 0
    strategy.entry("H", strategy.short, qty=1)
else if strategy.position_size < 0
    strategy.exit("X", profit=5)
