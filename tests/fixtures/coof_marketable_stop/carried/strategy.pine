//@version=6
strategy("Callback stop after a carried entry", overlay=true, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0, pyramiding=2, calc_on_order_fills=true)
varip bool priorSent = false
varip bool carriedSent = false
if time == timestamp("UTC", 2025, 4, 6, 9, 15) and not priorSent
    strategy.entry("prior", strategy.short)
    priorSent := true
if time == timestamp("UTC", 2025, 4, 6, 9, 45) and not carriedSent
    strategy.exit("prior-stop", "prior", stop=83075.15)
    strategy.entry("carried", strategy.short)
    carriedSent := true
if strategy.opentrades > 0 and strategy.opentrades.entry_id(strategy.opentrades - 1) == "carried"
    strategy.exit("callback-stop", "carried", stop=83000)
