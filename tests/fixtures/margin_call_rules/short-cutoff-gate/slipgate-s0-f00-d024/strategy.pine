strategy("n2c-slipgate-s0-f00-d024", initial_capital=89320.421448, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0, process_orders_on_close=true)
