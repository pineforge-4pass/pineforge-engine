//@version=6
strategy("n2b-r3-admit-eth-nonpooc-s2-gapup", initial_capital=4057.275, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.0, slippage=2, process_orders_on_close=false, calc_on_order_fills=false)
if time == timestamp("UTC", 2025, 5, 23, 2, 45) and strategy.position_size == 0
    strategy.entry("probe", strategy.long, qty=1.5)
if time == timestamp("UTC", 2025, 5, 23, 3, 15)
    strategy.close_all()
plot(strategy.equity, "equity")
plot(strategy.position_size, "held")
plot(strategy.netprofit, "netprofit")
plot(strategy.openprofit, "openprofit")
