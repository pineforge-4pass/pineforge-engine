//@version=6
strategy("n2b-admit-eur-short-ulp-p2u", initial_capital=97155.900002, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0, process_orders_on_close=true, calc_on_order_fills=false)
if time == timestamp("UTC", 2025, 4, 2, 4, 15) and strategy.position_size == 0
    strategy.entry("probe", strategy.short, qty=90000.0)
if time == timestamp("UTC", 2025, 4, 2, 4, 30)
    strategy.close_all()
plot(strategy.equity, "equity")
plot(strategy.position_size, "held")
plot(strategy.netprofit, "netprofit")
plot(strategy.openprofit, "openprofit")
