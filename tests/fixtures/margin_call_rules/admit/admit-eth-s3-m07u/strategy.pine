//@version=6
strategy("n2b-admit-eth-s3-m07u", initial_capital=2416.1849993, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.0, slippage=3, process_orders_on_close=true, calc_on_order_fills=false)
if time == timestamp("UTC", 2025, 4, 8, 2, 0) and strategy.position_size == 0
    strategy.entry("probe", strategy.long, qty=1.5)
if time == timestamp("UTC", 2025, 4, 8, 2, 30)
    strategy.close_all()
plot(strategy.equity, "equity")
plot(strategy.position_size, "held")
plot(strategy.netprofit, "netprofit")
plot(strategy.openprofit, "openprofit")
