//@version=6
strategy("n12-c1r3-fee0-b-pct-short-s1", initial_capital=5039.45, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.0, slippage=1, process_orders_on_close=true, calc_on_order_fills=false, default_qty_type=strategy.percent_of_equity, default_qty_value=100)
if time == timestamp("UTC", 2025, 6, 1, 0, 0) and strategy.position_size == 0
    strategy.entry("probe", strategy.short)
if time == timestamp("UTC", 2025, 6, 1, 0, 30)
    strategy.close_all()
plot(strategy.equity, "equity")
plot(strategy.position_size, "held")
plot(strategy.netprofit, "netprofit")
plot(strategy.openprofit, "openprofit")
