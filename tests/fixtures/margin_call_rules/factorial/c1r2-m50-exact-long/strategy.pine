//@version=6
strategy("n12-c1r2-m50-exact-long", initial_capital=2602.935, margin_long=50, margin_short=50, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0, process_orders_on_close=false, calc_on_order_fills=false)
if time == timestamp("UTC", 2025, 1, 2, 11, 45) and strategy.position_size == 0
    strategy.entry("probe", strategy.long, qty=1.5)
if time == timestamp("UTC", 2025, 1, 2, 12, 0)
    strategy.close_all()
plot(strategy.equity, "equity")
plot(strategy.position_size, "held")
plot(strategy.netprofit, "netprofit")
plot(strategy.openprofit, "openprofit")
