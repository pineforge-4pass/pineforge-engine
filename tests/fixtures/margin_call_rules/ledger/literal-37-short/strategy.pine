//@version=6
strategy("n2-ledger-member-37-literal-short", initial_capital=89373.93849057386, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1, process_orders_on_close=true, calc_on_order_fills=false)
if time == timestamp("UTC", 2025, 4, 18, 12, 0) and strategy.position_size == 0
    strategy.entry("ledger-0", strategy.short, qty=100)
if time == timestamp("UTC", 2025, 4, 18, 12, 30)
    strategy.close_all()
if time == timestamp("UTC", 2025, 4, 18, 13, 0) and strategy.position_size == 0
    strategy.entry("probe", strategy.short, qty=78546.87)
if time == timestamp("UTC", 2025, 4, 18, 13, 30)
    strategy.close_all()
plot(strategy.equity, "equity")
plot(strategy.position_size, "held")
plot(strategy.netprofit, "netprofit")
plot(strategy.openprofit, "openprofit")
plot(math.floor(strategy.equity / close / 0.01) * 0.01, "source-size")
