//@version=6
strategy("n2-stop-11-explicit", initial_capital=99600.36215999999, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0, slippage=0, process_orders_on_close=false, calc_on_order_fills=false)
if time == timestamp("UTC", 2025, 4, 2, 8, 0) and strategy.position_size == 0
    strategy.entry("probe", strategy.long, qty=1.17923, stop=84462.16)
if time == timestamp("UTC", 2025, 4, 2, 8, 45)
    strategy.close_all()
plot(strategy.equity, "equity")
plot(strategy.position_size, "held")
plot(strategy.netprofit, "netprofit")
plot(strategy.openprofit, "openprofit")
plot(math.floor(strategy.equity / close / 0.00001) * 0.00001, "source-size")
