//@version=6
strategy("n2-origin-1315-d0p32", initial_capital=10737.2801947935, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.05, slippage=5, process_orders_on_close=true, calc_on_order_fills=false)
if time == timestamp("UTC", 2025, 4, 8, 13, 15) and strategy.position_size == 0
    strategy.entry("probe", strategy.short, qty=6.7883)
if time == timestamp("UTC", 2025, 4, 8, 14, 0)
    strategy.close_all()
plot(strategy.equity, "equity")
plot(strategy.position_size, "held")
plot(strategy.netprofit, "netprofit")
plot(strategy.openprofit, "openprofit")
plot(math.floor(strategy.equity / close / 0.0001) * 0.0001, "source-size")
