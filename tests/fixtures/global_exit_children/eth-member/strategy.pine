//@version=6
strategy("n5b-16-eth-member",initial_capital=5000,pyramiding=3,margin_long=0,margin_short=0,close_entries_rule="FIFO",commission_type=strategy.commission.percent,commission_value=0.04,process_orders_on_close=true,slippage=3)
if time == timestamp("UTC",2025,5,21,5,0,0)
    strategy.entry("S1",strategy.short,qty=2.0266,limit=2586.88)
if time == timestamp("UTC",2025,5,21,6,30,0)
    strategy.entry("S2",strategy.short,qty=1.9939,limit=2608.87)
if strategy.position_size < 0 and time < timestamp("UTC",2025,5,21,6,30,0)
    strategy.exit("xS1",from_entry="S1",stop=2586.88*1.02,limit=2483.4)
if strategy.position_size < 0 and time >= timestamp("UTC",2025,5,21,6,30,0) and time < timestamp("UTC",2025,5,21,7,0,0)
    strategy.exit("xS1",from_entry="S1",stop=2608.87*1.02,limit=2483.4)
    strategy.exit("xS2",from_entry="S2",stop=2608.87*1.02,limit=2483.4)
if strategy.position_size < 0 and time >= timestamp("UTC",2025,5,21,7,0,0)
    strategy.exit("xS1",from_entry="S1",stop=2586.88*(1-0.0025),limit=2483.4)
    strategy.exit("xS2",from_entry="S2",stop=2586.88*(1-0.0025),limit=2483.4)
if time == timestamp("UTC",2025,5,22,12,0,0)
    strategy.close_all()
