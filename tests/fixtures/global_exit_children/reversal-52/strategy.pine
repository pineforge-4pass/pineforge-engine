//@version=6
strategy("n5-52-reversal",initial_capital=500000,pyramiding=2,margin_long=100,margin_short=100,close_entries_rule="FIFO",commission_type=strategy.commission.cash_per_contract,commission_value=20)
if time == timestamp("UTC",2025,07,04,04,00,00)
    strategy.entry("RevShort",strategy.short,qty=2)
    strategy.exit("R1",from_entry="RevShort",qty=1,limit=24000,stop=27000)
    strategy.exit("R2",from_entry="RevShort",qty=1,limit=23000,stop=27000)
if time == timestamp("UTC",2025,07,04,09,00,00)
    strategy.entry("RevLong",strategy.long,qty=2)
if time == timestamp("UTC",2025,07,07,04,00,00)
    strategy.entry("Long",strategy.long,qty=2)
if time == timestamp("UTC",2025,07,07,06,15,00)
    strategy.cancel_all()
    strategy.close("Long")
    strategy.close("LongAdd")
    strategy.entry("RevShort",strategy.short,qty=2)
    strategy.exit("R1",from_entry="RevShort",qty=1,limit=25399,stop=25480.9)
    strategy.exit("R2",from_entry="RevShort",qty=1,limit=25359,stop=25480.9)
if time == timestamp("UTC",2025,07,08,12,00,00)
    strategy.close_all()
