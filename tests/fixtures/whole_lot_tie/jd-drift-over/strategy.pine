//@version=6
// Synthetic probe (lane TAIL-D), NYSE:F 1D. A fixed-size trade realizes a loss that, added
// to the capital, sums one ulp over its cent value; an all-in long is then reversed on a
// bar where the equity is an exact whole-share multiple of the close, the next open a gap up.
strategy("jd-drift-over", overlay = true, initial_capital = 97079.94, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, margin_long = 100, margin_short = 100)
isDay(int y, int m, int d) => year == y and month == m and dayofmonth == d
if isDay(2025, 4, 4)
    strategy.entry("P", strategy.long, qty = 102)
if isDay(2025, 4, 8)
    strategy.close("P")
if isDay(2025, 9, 2)
    strategy.entry("Long", strategy.long)
if isDay(2025, 9, 4)
    strategy.entry("Short", strategy.short)
if isDay(2025, 9, 10)
    strategy.close_all()
