//@version=6
strategy("pf-recheck-a2-gate-veto-s2g5", initial_capital=94447.0156, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, process_orders_on_close=true)
if time == timestamp("UTC", 2025, 7, 2, 2, 45)
    strategy.entry("S", strategy.short, qty=80000.0)
if time == timestamp("UTC", 2025, 7, 2, 3, 0)
    strategy.close_all()
plot(strategy.equity, "equity")
