//@version=6
strategy("pf-12bf-k2-overfill-closeid-default", initial_capital=21801.6902, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1, process_orders_on_close=true, pyramiding=0)
if time == timestamp("UTC", 2026, 4, 9, 1, 0)
    strategy.entry("S", strategy.short, qty=18667.93)
if time == timestamp("UTC", 2026, 4, 9, 1, 45)
    strategy.close("S")
    strategy.entry("L", strategy.long)
if time == timestamp("UTC", 2026, 4, 9, 2, 0)
    strategy.close("L")
    strategy.entry("S2", strategy.short, qty=18000.0)
if time == timestamp("UTC", 2026, 4, 9, 2, 15)
    strategy.close_all()
plot(strategy.equity, "equity")
