//@version=6
// TAIL-D synthetic M1i: NYSE:F (half-cent extremes on a one-cent tick). A take-profit leg of a
// position of 2 fills mid-leg; the calc_on_order_fills recalculation of that fill calls
// strategy.close("P", immediately = true). process_orders_on_close on.
strategy("td-m1i-imm-closeid-offgrid", overlay = true, process_orders_on_close = true, calc_on_order_fills = true, default_qty_type = strategy.fixed, default_qty_value = 2, initial_capital = 1000000)
nClosed = strategy.closedtrades
lastExitHere = nClosed > 0 and strategy.closedtrades.exit_bar_index(nClosed - 1) == bar_index
lastExitWasTP = nClosed > 0 and strategy.closedtrades.exit_id(nClosed - 1) == "TP"
flat = strategy.position_size == 0
if flat and not lastExitHere
    strategy.entry("P", bar_index % 2 == 0 ? strategy.long : strategy.short, qty = 2)
if strategy.position_size != 0
    avg = strategy.position_avg_price
    if math.abs(strategy.position_size) == 2
        strategy.exit("TP", "P", qty = 1, limit = strategy.position_size > 0 ? avg + 0.02 : avg - 0.02)
    if lastExitHere and lastExitWasTP
        strategy.close("P", comment = "IMM", immediately = true)
    if bar_index - strategy.opentrades.entry_bar_index(0) >= 3
        strategy.close_all(comment = "TIME")
