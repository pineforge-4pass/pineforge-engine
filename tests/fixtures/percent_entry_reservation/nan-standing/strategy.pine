//@version=6
strategy("Standing target absent operand",overlay=true,initial_capital=1000000,margin_long=0,margin_short=0)
if time == timestamp("UTC",2025,4,4,14,0)
    strategy.entry("seed",strategy.short,qty=10)
if strategy.position_size < 0
    float target = time < timestamp("UTC",2025,4,5,0,0) ? 1771.14 : na
    strategy.exit("target","seed",limit=target)
if time == timestamp("UTC",2025,4,6,0,0)
    strategy.close_all(comment="end")
