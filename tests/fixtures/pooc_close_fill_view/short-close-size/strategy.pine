//@version=6
strategy("sig18-k3-short-close-view", initial_capital=100000, pyramiding=0, process_orders_on_close=true)
var float seen = na
if time == timestamp("UTC", 2026, 1, 8, 19, 45)
    strategy.entry("seed", strategy.short, qty=1)
if time == timestamp("UTC", 2026, 1, 8, 23, 15)
    strategy.close("seed")
    seen := strategy.position_size
if time == timestamp("UTC", 2026, 1, 8, 23, 30)
    if seen < 0
        strategy.entry("SAWPOS", strategy.short, qty=1)
    if seen == 0
        strategy.entry("SAWFLAT", strategy.short, qty=2)
if time == timestamp("UTC", 2026, 1, 9, 1, 0)
    strategy.close_all()
