//@version=6
strategy("BTC EMA Crossover Research", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.1, margin_long=100, margin_short=100)
fastLength = input.int(20, "Fast Length", minval=1)
slowLength = input.int(50, "Slow Length", minval=1)
fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
longSignal = ta.crossover(fastEma, slowEma)
exitSignal = ta.crossunder(fastEma, slowEma)
if longSignal
    strategy.entry("Long", strategy.long)
if exitSignal
    strategy.close("Long")