//@version=6
strategy("N1 roi-history-k19-only", initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
var string witness = ""
if time == timestamp("UTC", 2025, 5, 13, 13, 30)
    strategy.entry("Ledger0", strategy.long, qty=9433)
if time == timestamp("UTC", 2025, 5, 21, 13, 30)
    strategy.entry("Ledger1", strategy.short, qty=9460)
if time == timestamp("UTC", 2025, 5, 29, 13, 30)
    strategy.entry("Ledger2", strategy.long, qty=9938)
if time == timestamp("UTC", 2025, 6, 2, 13, 30)
    strategy.entry("Ledger3", strategy.short, qty=10015)
if time == timestamp("UTC", 2025, 6, 16, 13, 30)
    strategy.entry("Ledger4", strategy.long, qty=8864)
if time == timestamp("UTC", 2025, 7, 16, 13, 30)
    strategy.entry("Ledger5", strategy.short, qty=8909)
if time == timestamp("UTC", 2025, 7, 23, 13, 30)
    strategy.entry("Ledger6", strategy.long, qty=8614)
if time == timestamp("UTC", 2025, 7, 30, 13, 30)
    strategy.entry("Ledger7", strategy.short, qty=8721)
if time == timestamp("UTC", 2025, 8, 13, 13, 30)
    strategy.entry("Ledger8", strategy.long, qty=7760)
if time == timestamp("UTC", 2025, 9, 9, 13, 30)
    strategy.entry("Ledger9", strategy.short, qty=7932)
if time == timestamp("UTC", 2025, 9, 11, 13, 30)
    strategy.entry("Ledger10", strategy.long, qty=7569)
if time == timestamp("UTC", 2025, 9, 19, 13, 30)
    strategy.entry("Seed", strategy.short, qty=7581)
if time == timestamp("UTC", 2025, 10, 1, 13, 30)
    witness := "E=" + str.tostring(strategy.equity, "#.################") + ";N=" + str.tostring(strategy.netprofit, "#.################") + ";OP=" + str.tostring(strategy.openprofit, "#.################") + ";P=" + str.tostring(strategy.position_size, "#.################") + ";C=" + str.tostring(close, "#.################") + ";T=" + str.tostring(math.round_to_mintick(close), "#.################")
    strategy.entry("Turn", strategy.long, comment=witness)
if time == timestamp("UTC", 2025, 10, 3, 13, 30)
    strategy.close_all(comment="SENSOR|" + witness)
