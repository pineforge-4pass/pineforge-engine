//@version=6
strategy("N1 proozac-history-k30-after", initial_capital=8395.1853030000002, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
var string witness = ""
if time == timestamp("UTC", 2025, 4, 30, 20, 0)
    strategy.entry("Ledger0", strategy.long, qty=4.6475999999999997)
if time == timestamp("UTC", 2025, 5, 1, 10, 30)
    strategy.entry("Ledger1", strategy.short, qty=4.6475999999999997)
if time == timestamp("UTC", 2025, 5, 1, 11, 0)
    strategy.entry("Ledger2", strategy.long, qty=4.5993000000000004)
if time == timestamp("UTC", 2025, 5, 1, 13, 30)
    strategy.entry("Ledger3", strategy.short, qty=4.5993000000000004)
if time == timestamp("UTC", 2025, 5, 1, 14, 0)
    strategy.entry("Ledger4", strategy.long, qty=4.5804)
if time == timestamp("UTC", 2025, 5, 1, 15, 15)
    strategy.entry("Ledger5", strategy.short, qty=4.5804)
if time == timestamp("UTC", 2025, 5, 2, 10, 30)
    strategy.entry("Ledger6", strategy.long, qty=4.7442000000000002)
if time == timestamp("UTC", 2025, 5, 3, 17, 0)
    strategy.entry("Ledger7", strategy.short, qty=4.7442000000000002)
if time == timestamp("UTC", 2025, 5, 4, 5, 15)
    strategy.entry("Ledger8", strategy.long, qty=4.6227)
if time == timestamp("UTC", 2025, 5, 4, 22, 30)
    strategy.entry("Ledger9", strategy.short, qty=4.6227)
if time == timestamp("UTC", 2025, 5, 5, 2, 0)
    strategy.entry("Ledger10", strategy.long, qty=4.7390999999999996)
if time == timestamp("UTC", 2025, 5, 5, 10, 30)
    strategy.entry("Ledger11", strategy.short, qty=4.7390999999999996)
if time == timestamp("UTC", 2025, 5, 5, 16, 15)
    strategy.entry("Ledger12", strategy.long, qty=4.7255000000000003)
if time == timestamp("UTC", 2025, 5, 5, 20, 30)
    strategy.entry("Ledger13", strategy.short, qty=4.7255000000000003)
if time == timestamp("UTC", 2025, 5, 5, 22, 30)
    strategy.entry("Ledger14", strategy.long, qty=4.5982000000000003)
if time == timestamp("UTC", 2025, 5, 6, 2, 15)
    strategy.entry("Seed", strategy.short, qty=4.5982000000000003)
if time == timestamp("UTC", 2025, 5, 6, 12, 0)
    witness := "E=" + str.tostring(strategy.equity, "#.################") + ";N=" + str.tostring(strategy.netprofit, "#.################") + ";OP=" + str.tostring(strategy.openprofit, "#.################") + ";P=" + str.tostring(strategy.position_size, "#.################") + ";C=" + str.tostring(close, "#.################") + ";T=" + str.tostring(math.round_to_mintick(close), "#.################") + ";D=" + str.tostring(strategy.default_entry_qty(math.round_to_mintick(close)), "#.################")
    strategy.entry("Turn", strategy.long, comment=witness)
    strategy.close("Seed")
if time == timestamp("UTC", 2025, 5, 6, 12, 30)
    strategy.close_all(comment="SENSOR|" + witness)
