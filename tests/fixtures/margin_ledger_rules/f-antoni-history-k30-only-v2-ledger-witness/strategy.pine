//@version=6
strategy("N1 f-antoni-history-k30-only-v2-ledger-witness", initial_capital=105668.25, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
var string witness = ""
var int consumed = 0
var float nativeSum = 0
var float directSum = 0
var float valueSum = 0
var float gainSum = 0
var float lossSum = 0
var string lastTrade = ""
if strategy.closedtrades > consumed
    for tradeIndex = consumed to strategy.closedtrades - 1
        entryPrice = strategy.closedtrades.entry_price(tradeIndex)
        exitPrice = strategy.closedtrades.exit_price(tradeIndex)
        signedQuantity = strategy.closedtrades.size(tradeIndex)
        nativeProfit = strategy.closedtrades.profit(tradeIndex)
        directProfit = (exitPrice - entryPrice) * signedQuantity
        nativeSum := nativeSum + nativeProfit
        directSum := directSum + directProfit
        valueSum := valueSum + math.sign(signedQuantity) * (exitPrice * math.abs(signedQuantity) - entryPrice * math.abs(signedQuantity))
        gainSum := gainSum + math.max(nativeProfit, 0)
        lossSum := lossSum + math.min(nativeProfit, 0)
        lastTrade := ";LP=" + str.tostring(nativeProfit, "#.################") + ";LE=" + str.tostring(entryPrice, "#.################") + ";LX=" + str.tostring(exitPrice, "#.################") + ";LQ=" + str.tostring(signedQuantity, "#.################")
    consumed := strategy.closedtrades
if time == timestamp("UTC", 2025, 7, 23, 18, 0)
    strategy.entry("Ledger0", strategy.short, qty=9301)
if time == timestamp("UTC", 2025, 7, 23, 18, 15)
    strategy.entry("Ledger1", strategy.long, qty=9268)
if time == timestamp("UTC", 2025, 7, 24, 16, 45)
    strategy.entry("Ledger2", strategy.short, qty=9268)
if time == timestamp("UTC", 2025, 7, 24, 17, 30)
    strategy.entry("Ledger3", strategy.long, qty=9219)
if time == timestamp("UTC", 2025, 7, 24, 18, 0)
    strategy.entry("Ledger4", strategy.short, qty=9219)
if time == timestamp("UTC", 2025, 7, 24, 19, 0)
    strategy.entry("Ledger5", strategy.long, qty=9252)
if time == timestamp("UTC", 2025, 7, 25, 14, 0)
    strategy.entry("Ledger6", strategy.short, qty=9252)
if time == timestamp("UTC", 2025, 7, 25, 14, 45)
    strategy.entry("Ledger7", strategy.long, qty=9219)
if time == timestamp("UTC", 2025, 7, 28, 15, 30)
    strategy.entry("Ledger8", strategy.short, qty=9219)
if time == timestamp("UTC", 2025, 7, 31, 18, 15)
    strategy.entry("Ledger9", strategy.long, qty=9751)
if time == timestamp("UTC", 2025, 7, 31, 19, 30)
    strategy.entry("Ledger10", strategy.short, qty=9751)
if time == timestamp("UTC", 2025, 7, 31, 19, 45)
    strategy.entry("Ledger11", strategy.long, qty=9646)
if time == timestamp("UTC", 2025, 8, 1, 14, 30)
    strategy.entry("Ledger12", strategy.short, qty=9910)
if time == timestamp("UTC", 2025, 8, 1, 14, 45)
    strategy.entry("Ledger13", strategy.long, qty=9873)
if time == timestamp("UTC", 2025, 8, 1, 16, 15)
    strategy.entry("Ledger14", strategy.short, qty=9873)
if time == timestamp("UTC", 2025, 8, 4, 18, 15)
    strategy.entry("Ledger15", strategy.long, qty=9550)
if time == timestamp("UTC", 2025, 8, 4, 19, 0)
    strategy.entry("Ledger16", strategy.short, qty=9550)
if time == timestamp("UTC", 2025, 8, 5, 13, 30)
    strategy.entry("Seed", strategy.long, qty=9429)
if time == timestamp("UTC", 2025, 8, 5, 14, 30)
    witness := "E=" + str.tostring(strategy.equity, "#.################") + ";N=" + str.tostring(strategy.netprofit, "#.################") + ";OP=" + str.tostring(strategy.openprofit, "#.################") + ";P=" + str.tostring(strategy.position_size, "#.################") + ";C=" + str.tostring(close, "#.################") + ";T=" + str.tostring(math.round_to_mintick(close), "#.################") + ";NS=" + str.tostring(nativeSum, "#.################") + ";DS=" + str.tostring(directSum, "#.################") + ";VS=" + str.tostring(valueSum, "#.################") + ";GS=" + str.tostring(gainSum, "#.################") + ";LS=" + str.tostring(lossSum, "#.################") + lastTrade
    strategy.entry("Turn", strategy.short, comment=witness)
if time == timestamp("UTC", 2025, 8, 5, 15, 0)
    strategy.close_all(comment="SENSOR|" + witness)
