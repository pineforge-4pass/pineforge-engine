//@version=6
strategy("N1 willow-history-k10-only-v2", initial_capital=74376.690000000002, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
var string witness = ""
if time == timestamp("UTC", 2026, 3, 17, 15, 45)
    strategy.entry("Ledger0", strategy.short, qty=6229)
if time == timestamp("UTC", 2026, 3, 17, 17, 45)
    strategy.entry("Ledger1", strategy.long, qty=6260)
if time == timestamp("UTC", 2026, 3, 17, 18, 0)
    strategy.entry("Ledger2", strategy.short, qty=6260)
if time == timestamp("UTC", 2026, 3, 18, 15, 15)
    strategy.entry("Ledger3", strategy.long, qty=6237)
if time == timestamp("UTC", 2026, 3, 18, 16, 45)
    strategy.entry("Ledger4", strategy.short, qty=6237)
if time == timestamp("UTC", 2026, 3, 18, 18, 15)
    strategy.entry("Seed", strategy.long, qty=6299)
if time == timestamp("UTC", 2026, 3, 19, 16, 30)
    witness := "E=" + str.tostring(strategy.equity, "#.################") + ";N=" + str.tostring(strategy.netprofit, "#.################") + ";OP=" + str.tostring(strategy.openprofit, "#.################") + ";P=" + str.tostring(strategy.position_size, "#.################") + ";C=" + str.tostring(close, "#.################") + ";T=" + str.tostring(math.round_to_mintick(close), "#.################")
    strategy.entry("Turn", strategy.short, comment=witness)
if time == timestamp("UTC", 2026, 3, 19, 17, 0)
    strategy.close_all(comment="SENSOR|" + witness)
