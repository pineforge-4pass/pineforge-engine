//@version=6
strategy("N1 f-antoni-history-k0-after-v2", initial_capital=104012.8, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
var string witness = ""
if time == timestamp("UTC", 2025, 8, 5, 13, 30)
    strategy.entry("Seed", strategy.long, qty=9429)
if time == timestamp("UTC", 2025, 8, 5, 14, 30)
    witness := "E=" + str.tostring(strategy.equity, "#.################") + ";N=" + str.tostring(strategy.netprofit, "#.################") + ";OP=" + str.tostring(strategy.openprofit, "#.################") + ";P=" + str.tostring(strategy.position_size, "#.################") + ";C=" + str.tostring(close, "#.################") + ";T=" + str.tostring(math.round_to_mintick(close), "#.################")
    strategy.entry("Turn", strategy.short, comment=witness)
    strategy.close("Seed")
if time == timestamp("UTC", 2025, 8, 5, 15, 0)
    strategy.close_all(comment="SENSOR|" + witness)
