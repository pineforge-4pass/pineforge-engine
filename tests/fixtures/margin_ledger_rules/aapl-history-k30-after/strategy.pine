//@version=6
strategy("N1 aapl-history-k30-after", initial_capital=96215.910000000003, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
var string witness = ""
if time == timestamp("UTC", 2026, 3, 27, 14, 45)
    strategy.entry("Ledger0", strategy.long, qty=379)
if time == timestamp("UTC", 2026, 3, 27, 17, 15)
    strategy.entry("Ledger1", strategy.short, qty=379)
if time == timestamp("UTC", 2026, 3, 30, 13, 45)
    strategy.entry("Ledger2", strategy.long, qty=388)
if time == timestamp("UTC", 2026, 3, 30, 17, 45)
    strategy.entry("Ledger3", strategy.short, qty=388)
if time == timestamp("UTC", 2026, 4, 1, 13, 30)
    strategy.entry("Ledger4", strategy.long, qty=362)
if time == timestamp("UTC", 2026, 4, 1, 13, 45)
    strategy.entry("Ledger5", strategy.short, qty=362)
if time == timestamp("UTC", 2026, 4, 1, 17, 15)
    strategy.entry("Ledger6", strategy.long, qty=361)
if time == timestamp("UTC", 2026, 4, 1, 17, 30)
    strategy.entry("Ledger7", strategy.short, qty=361)
if time == timestamp("UTC", 2026, 4, 1, 18, 0)
    strategy.entry("Ledger8", strategy.long, qty=361)
if time == timestamp("UTC", 2026, 4, 1, 18, 15)
    strategy.entry("Ledger9", strategy.short, qty=361)
if time == timestamp("UTC", 2026, 4, 1, 18, 30)
    strategy.entry("Ledger10", strategy.long, qty=361)
if time == timestamp("UTC", 2026, 4, 1, 18, 45)
    strategy.entry("Ledger11", strategy.short, qty=360)
if time == timestamp("UTC", 2026, 4, 1, 19, 0)
    strategy.entry("Ledger12", strategy.long, qty=359)
if time == timestamp("UTC", 2026, 4, 1, 19, 45)
    strategy.entry("Ledger13", strategy.short, qty=359)
if time == timestamp("UTC", 2026, 4, 2, 14, 45)
    strategy.entry("Seed", strategy.long, qty=356)
if time == timestamp("UTC", 2026, 4, 2, 15, 0)
    witness := "E=" + str.tostring(strategy.equity, "#.################") + ";N=" + str.tostring(strategy.netprofit, "#.################") + ";OP=" + str.tostring(strategy.openprofit, "#.################") + ";P=" + str.tostring(strategy.position_size, "#.################") + ";C=" + str.tostring(close, "#.################") + ";T=" + str.tostring(math.round_to_mintick(close), "#.################") + ";D=" + str.tostring(strategy.default_entry_qty(math.round_to_mintick(close)), "#.################")
    strategy.entry("Turn", strategy.short, comment=witness)
    strategy.close("Seed")
if time == timestamp("UTC", 2026, 4, 2, 15, 30)
    strategy.close_all(comment="SENSOR|" + witness)
