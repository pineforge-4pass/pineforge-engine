//@version=6
strategy("Same-bar fallback S25", pyramiding=3, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0)

if bar_index == 0
    strategy.entry("S", strategy.short)
if bar_index == 2
    strategy.entry("B", strategy.short)
    strategy.exit("XB", "B", limit=95.0, stop=105.0)
if bar_index == 7
    strategy.close_all()
