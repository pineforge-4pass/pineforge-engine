//@version=6
strategy("Same-bar fallback S30", pyramiding=2, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0)

if bar_index == 0
    strategy.entry("A", strategy.long, qty=1.0)
if bar_index == 1
    strategy.entry("R", strategy.long, limit=151.0, stop=150.0, qty=1.0)
if bar_index == 2
    strategy.entry("M", strategy.long, qty=1.0)
if bar_index == 7
    strategy.cancel_all()
    strategy.close_all()
