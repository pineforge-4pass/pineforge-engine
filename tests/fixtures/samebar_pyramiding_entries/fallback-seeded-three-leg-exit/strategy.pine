//@version=6
strategy("Same-bar fallback seeded-three-leg-exit", pyramiding=7, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0)

if bar_index == 0
    strategy.entry("seed", strategy.short, qty=1.0)
if bar_index == 2
    strategy.entry("L", strategy.long, qty=1.0)
    strategy.entry("S", strategy.short, qty=1.0)
    strategy.entry("L2", strategy.long, qty=1.0)
    strategy.exit("X", "L2", limit=105.0, stop=95.0)
if bar_index == 7
    strategy.close_all()
