//@version=6
strategy("Same-bar single entry and sibling exits", pyramiding=10, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0)
if bar_index == 0
    strategy.entry("E", strategy.long, qty=2)
    strategy.exit("T1", "E", limit=105, stop=95, qty=1)
    strategy.exit("T2", "E", limit=105, stop=95, qty=1)
