//@version=6
strategy("Same-bar fallback S25b", pyramiding=3, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0)

if bar_index == 0
    strategy.entry("S", strategy.long)
if bar_index == 2
    strategy.entry("B", strategy.long)
    strategy.exit("XB", "B", limit=105.0, stop=95.0)
if bar_index == 7
    strategy.close_all()
