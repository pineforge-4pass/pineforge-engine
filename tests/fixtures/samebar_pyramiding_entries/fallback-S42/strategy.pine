//@version=6
strategy("Same-bar fallback S42", pyramiding=3, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0)

if bar_index == 0
    strategy.entry("A", strategy.long, qty=1.0)
    strategy.entry("P", strategy.short, limit=100.5, qty=1.0)
    strategy.entry("B", strategy.short, qty=1.0)
    strategy.entry("C", strategy.long, qty=1.0)
if bar_index == 7
    strategy.cancel_all()
    strategy.close_all()
