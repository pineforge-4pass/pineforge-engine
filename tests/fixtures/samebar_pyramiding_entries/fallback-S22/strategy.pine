//@version=6
strategy("Same-bar fallback S22", pyramiding=3, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0)

if bar_index == 0
    strategy.order("O", strategy.long, qty=1.0)
    strategy.entry("A", strategy.short, qty=1.0)
    strategy.entry("B", strategy.long, qty=1.0)
if bar_index == 7
    strategy.close_all()
