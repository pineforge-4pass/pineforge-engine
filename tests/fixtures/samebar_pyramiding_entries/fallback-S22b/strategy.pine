//@version=6
strategy("Same-bar fallback S22b", pyramiding=3, initial_capital=1000000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=0, margin_short=0)

if bar_index == 0
    strategy.entry("A", strategy.long, qty=2.0)
if bar_index == 1
    strategy.entry("A2", strategy.long, qty=1.0)
if bar_index == 3
    strategy.order("O", strategy.long, qty=1.0)
    strategy.entry("M", strategy.long, qty=1.0)
if bar_index == 7
    strategy.close_all()
