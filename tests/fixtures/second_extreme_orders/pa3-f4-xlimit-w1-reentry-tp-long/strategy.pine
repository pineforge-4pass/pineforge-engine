//@version=6
// PAR-ORDERS-3 (R5 lane) finding 4: an EXIT limit exactly on a bar's FIRST extreme,
// then the market re-entry, then the re-entry's own exit limit X2 between the two
// extremes -- on the far side of the re-entry's price, so already marketable. Market
// entry E fills at bar j's open; X sits at the high of the high-first bar.
// Everything is closed on bar j+2. Cycles j = 2, 32, 44.
// NYSE:F 15m, the three replayed days of tests/fixtures/session_islastbar
// (2025-07-02, 07-03 half day, 07-07); k counts chart bars from 2025-07-02
// 09:30 ET. No order is placed after 07-07 15:45 ET; whatever is open then is
// closed on the next bar, outside the replay.
strategy("PA3 F4 xlimit-w1 reentry tp long", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=100,
     pyramiding=1, commission_type=strategy.commission.percent, commission_value=0.01,
     slippage=0, process_orders_on_close=false, calc_on_order_fills=true,
     margin_long=100, margin_short=100, use_bar_magnifier=false)

t0 = timestamp("America/New_York", 2025, 7, 2, 9, 30)
tEnd = timestamp("America/New_York", 2025, 7, 7, 16, 0)
var int b0 = na
if na(b0) and time >= t0
    b0 := bar_index
k = na(b0) ? -1 : bar_index - b0
units = strategy.position_size
closedNow = strategy.closedtrades - nz(strategy.closedtrades[1])
xLimit = k == 2 ? 11.48 : k == 32 ? 11.86 : k == 44 ? 11.72 : na
tpLimit = k == 2 ? 11.44 : k == 32 ? 11.83 : k == 44 ? 11.69 : na
if k >= 0 and time < tEnd
    if (k == 1 or k == 31 or k == 43) and units == 0
        strategy.entry("E", strategy.long)
    if not na(xLimit) and units == 100 and closedNow == 0
        strategy.exit("X", "E", limit=xLimit)
    if not na(xLimit) and units == 0 and closedNow == 1
        strategy.entry("E", strategy.long)
    if not na(tpLimit) and units == 100 and closedNow == 1
        strategy.exit("X2", "E", limit=tpLimit)
    if (k == 4 or k == 34 or k == 46) and units != 0
        strategy.cancel_all()
        strategy.close_all()
if time >= tEnd and strategy.position_size != 0
    strategy.cancel_all()
    strategy.close_all(comment="after-window")
