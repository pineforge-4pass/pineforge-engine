//@version=6
// INT27 round 2 (R5 integration; the boundary of R5 lane PAR-ORDERS-3, finding 4): a
// fill booked AT a bar's FIRST extreme by an exit limit that was already marketable
// where the open's refill recalculation placed it, its level exactly on that extreme.
// Lot E is open from bar j-2; its exit limit X, placed at bar j-1's close exactly at
// bar j's low, fills at bar j's open; X's recalculation re-enters E, which fills at
// the open too; that E's recalculation places the exit limit X2 at X's level, already
// through, which the path reaches at the low, the first extreme of a low-first bar;
// X2's recalculation re-enters E. Everything is closed on bar j+2. Cycles j = 28, 61.
// NYSE:F 15m, the three replayed days of tests/fixtures/session_islastbar
// (2025-07-02, 07-03 half day, 07-07); k counts chart bars from 2025-07-02
// 09:30 ET. No order is placed after 07-07 15:45 ET; whatever is open then is
// closed on the next bar, outside the replay.
strategy("INT27 open xlimit-at-w1 reentry long", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=100,
     pyramiding=1, commission_type=strategy.commission.percent, commission_value=0.01,
     slippage=0, process_orders_on_close=false, calc_on_order_fills=true,
     margin_long=100, margin_short=100, use_bar_magnifier=false)

t0 = timestamp("America/New_York", 2025, 7, 2, 9, 30)
tEnd = timestamp("America/New_York", 2025, 7, 7, 16, 0)
var int b0 = na
if na(b0) and time >= t0
    b0 := bar_index
k = na(b0) ? -1 : bar_index - b0
units = strategy.position_size
closedNow = strategy.closedtrades - nz(strategy.closedtrades[1])
xLimit = k == 27 or k == 28 ? 11.84 : k == 60 or k == 61 ? 11.55 : na
if k >= 0 and time < tEnd
    if (k == 25 or k == 58) and units == 0
        strategy.entry("E", strategy.long)
    if (k == 27 or k == 60) and units == 100 and closedNow == 0
        strategy.exit("X", "E", limit=xLimit)
    if (k == 28 or k == 61) and units == 0 and closedNow >= 1
        strategy.entry("E", strategy.long)
    if (k == 28 or k == 61) and units == 100 and closedNow == 1
        strategy.exit("X2", "E", limit=xLimit)
    if (k == 30 or k == 63) and units != 0
        strategy.cancel_all()
        strategy.close_all()
if time >= tEnd and strategy.position_size != 0
    strategy.cancel_all()
    strategy.close_all(comment="after-window")
