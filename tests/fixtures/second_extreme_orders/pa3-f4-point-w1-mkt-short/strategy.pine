//@version=6
// PAR-ORDERS-3 (R5 lane) finding 4, the control: an order a recalculation places on
// a fill the adapter forces onto a bar's FIRST extreme. Lot P is open with a stop exit
// PX between bar j's open and its high, the first extreme of a high-first bar: PX
// fills on the leg to it, and its recalculation places the market entry A, which fills
// at the high itself; A's recalculation places the market entry B (pyramiding 2).
// Everything is closed on bar j+2. Cycles j = 2, 30.
// NYSE:F 15m, the three replayed days of tests/fixtures/session_islastbar
// (2025-07-02, 07-03 half day, 07-07); k counts chart bars from 2025-07-02
// 09:30 ET. No order is placed after 07-07 15:45 ET; whatever is open then is
// closed on the next bar, outside the replay.
strategy("PA3 F4 point-w1 mkt short", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=100,
     pyramiding=2, commission_type=strategy.commission.percent, commission_value=0.01,
     slippage=0, process_orders_on_close=false, calc_on_order_fills=true,
     margin_long=100, margin_short=100, use_bar_magnifier=false)

t0 = timestamp("America/New_York", 2025, 7, 2, 9, 30)
tEnd = timestamp("America/New_York", 2025, 7, 7, 16, 0)
var int b0 = na
if na(b0) and time >= t0
    b0 := bar_index
k = na(b0) ? -1 : bar_index - b0
units = strategy.position_size
closedNow = strategy.closedtrades - nz(strategy.closedtrades[1])
pxStop = k == 1 ? 11.46 : k == 29 ? 11.85 : na
if k >= 0 and time < tEnd
    if not na(pxStop) and units == 0
        strategy.entry("P", strategy.short)
        strategy.exit("PX", "P", stop=pxStop)
    if (k == 2 or k == 30) and units == 0 and closedNow == 1
        strategy.entry("A", strategy.short)
    if (k == 2 or k == 30) and units == -100 and strategy.opentrades.entry_id(0) == "A"
        strategy.entry("B", strategy.short)
    if (k == 4 or k == 32) and units != 0
        strategy.close_all()
if time >= tEnd and strategy.position_size != 0
    strategy.cancel_all()
    strategy.close_all(comment="after-window")
