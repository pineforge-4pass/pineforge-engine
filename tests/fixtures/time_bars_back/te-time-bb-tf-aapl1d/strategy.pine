//@version=6
// time() / time_close() with a bar offset on a requested timeframe: the chart
// offset (bars_back) and the requested one (timeframe_bars_back), ahead and
// back, on the hour, the day, the week and the month. Every bar spells the
// values in UTC: flat bars as the entry's name, bars holding the position as
// the close's comment.
strategy("PF te time bars_back tf", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)
f(int t) => na(t) ? "na" : str.format_time(t, "MMdd-HHmm", "UTC")
v = f(time) + "|" + f(time("60")) + "|" + f(time("60", -1)) + "|" + f(time("60", 0, -1))
     + "|" + f(time("60", 0, 1)) + "|" + f(time("D")) + "|" + f(time("D", -1)) + "|" + f(time("D", 0, -1))
     + "|" + f(time("D", 0, 1)) + "|" + f(time_close("D", 0, -1)) + "|" + f(time("W", 0, -1))
     + "|" + f(time("M", 0, -1)) + "|" + f(time("D", "", 1, -1))
if strategy.position_size == 0
    strategy.entry(v, strategy.long)
else
    strategy.close_all(comment = v)
