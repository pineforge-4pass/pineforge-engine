// H-MEASURE H4 NYSE:F short pending limit-entry trail arm (H-MEASURE research, group orders).
// Row 4 (E5 pending-entry arm), LIMIT-entry variant: strategy.entry(limit=X) and
// strategy.exit(trail_points=n, trail_offset=1) are issued together on the signal bar;
// the limit fills later MID-BAR (the path crosses X; open and earlier extremes stay a
// tick away, so no gap and no quantization ambiguity), and the trail may arm on the
// rest of the fill bar. The arm bar's raw extreme stops inside the activation's tick
// cell: a quantized arm exits there at activation -/+ 1 tick, a raw arm later. (UTC):
//   2025-04-23 14:45  limit 9.89 (fills 2025-04-23 15:00)  trail_points 7
//   2025-04-30 18:00  limit 9.94 (fills 2025-04-30 18:15)  trail_points 4
//   2025-05-05 15:15  limit 10.19 (fills 2025-05-05 15:45)  trail_points 3
//   2025-05-28 15:45  limit 10.17 (fills 2025-05-28 16:00)  trail_points 1
//   2025-06-02 19:30  limit 9.97 (fills 2025-06-02 19:45)  trail_points 8
//   2025-12-08 15:00  limit 13.13 (fills 2025-12-08 15:15)  trail_points 9
//@version=6
strategy("H-MEASURE H4 NYSE:F short pending limit-entry trail arm", overlay=true, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=100, pyramiding=1,
     commission_type=strategy.commission.percent, commission_value=0, slippage=0,
     process_orders_on_close=false, margin_long=100, margin_short=100)

var float pts = na
var float lvl = na
bool go = false
if strategy.position_size == 0
    if time == timestamp("UTC", 2025, 4, 23, 14, 45)
        pts := 7
        lvl := 9.89
        go := true
    else if time == timestamp("UTC", 2025, 4, 30, 18, 0)
        pts := 4
        lvl := 9.94
        go := true
    else if time == timestamp("UTC", 2025, 5, 5, 15, 15)
        pts := 3
        lvl := 10.19
        go := true
    else if time == timestamp("UTC", 2025, 5, 28, 15, 45)
        pts := 1
        lvl := 10.17
        go := true
    else if time == timestamp("UTC", 2025, 6, 2, 19, 30)
        pts := 8
        lvl := 9.97
        go := true
    else if time == timestamp("UTC", 2025, 12, 8, 15, 0)
        pts := 9
        lvl := 13.13
        go := true

// The limit entry and its trailing exit are issued on the same (signal) bar.
if go
    strategy.entry("S", strategy.short, limit=lvl)
    strategy.exit("SX", "S", trail_points=pts, trail_offset=1)

if strategy.position_size < 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= 25
    strategy.close("S", comment="timeout")
