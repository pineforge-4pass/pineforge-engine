// H-MEASURE H3 NYSE:F long pending-entry trail seed (H-MEASURE research, group orders).
// Row 3 (E14 anchored-leg seed): where does the running best of a trail whose
// strategy.exit was issued while its entry was PENDING start? The arm bar's raw
// extreme stops inside the activation's tick cell; a best that starts AT the
// activation (lane E14, filled entries) exits on the event bar, a best that
// starts at the raw arm print exits later.
// NYSE:F 15m (sub-cent prints). Each entry is a MARKET strategy.entry issued on
// its signal bar together with strategy.exit(trail_points, trail_offset); the
// entry fills at the next bar's open. Events (UTC signal bar -> fill bar):
//   2025-05-27 13:45 -> 2025-05-27 14:00  trail_points 6  trail_offset 5
//   2025-06-26 16:30 -> 2025-06-26 16:45  trail_points 1  trail_offset 3
//   2025-07-25 14:00 -> 2025-07-25 14:15  trail_points 3  trail_offset 5
//   2025-08-25 14:30 -> 2025-08-25 14:45  trail_points 4  trail_offset 3
//   2025-09-11 18:00 -> 2025-09-11 18:15  trail_points 1  trail_offset 5
//   2025-10-02 16:45 -> 2025-10-02 17:00  trail_points 4  trail_offset 5
//   2025-12-29 14:30 -> 2025-12-29 14:45  trail_points 4  trail_offset 5
//   2026-03-25 15:45 -> 2026-03-25 16:00  trail_points 2  trail_offset 5
//@version=6
strategy("H-MEASURE H3 NYSE:F long pending-entry trail seed", overlay=true, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=100, pyramiding=1,
     commission_type=strategy.commission.percent, commission_value=0, slippage=0,
     process_orders_on_close=false, margin_long=100, margin_short=100)

var float pts = na
var float off = na
bool go = false
if strategy.position_size == 0
    if time == timestamp("UTC", 2025, 5, 27, 13, 45)
        pts := 6
        off := 5
        go := true
    else if time == timestamp("UTC", 2025, 6, 26, 16, 30)
        pts := 1
        off := 3
        go := true
    else if time == timestamp("UTC", 2025, 7, 25, 14, 0)
        pts := 3
        off := 5
        go := true
    else if time == timestamp("UTC", 2025, 8, 25, 14, 30)
        pts := 4
        off := 3
        go := true
    else if time == timestamp("UTC", 2025, 9, 11, 18, 0)
        pts := 1
        off := 5
        go := true
    else if time == timestamp("UTC", 2025, 10, 2, 16, 45)
        pts := 4
        off := 5
        go := true
    else if time == timestamp("UTC", 2025, 12, 29, 14, 30)
        pts := 4
        off := 5
        go := true
    else if time == timestamp("UTC", 2026, 3, 25, 15, 45)
        pts := 2
        off := 5
        go := true

// The entry and its trailing exit are issued on the same (signal) bar: the exit
// is placed while the entry is still pending.
if go
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", trail_points=pts, trail_offset=off)

if strategy.position_size > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= 25
    strategy.close("L", comment="timeout")
