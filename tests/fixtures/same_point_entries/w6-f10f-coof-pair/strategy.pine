//@version=6
strategy("W6 F10f opposite pair at one open (COOF)", overlay=true,
     initial_capital=1000000, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=0, margin_long=100, margin_short=100,
     process_orders_on_close=false, calc_on_order_fills=true)

// Lane W6-ENG-FILL-ORDER, family F10. From flat, two opposite
// strategy.entry calls on one confirmed bar (once per bar: a recalculation
// after a fill places nothing), process_orders_on_close=false,
// calc_on_order_fills=true. Priced legs are marketable (buy stop / sell limit
// at half the close, sell stop / buy limit at twice the close). The signal
// names show which leg TradingView fills first. Each cell is flattened on
// the bar 30 minutes later.

int t0 = timestamp("UTC", 2025, 4, 8, 0, 0)
int stepMs = 2 * 60 * 60 * 1000
int nCells = 8
int rel = time - t0
bool inRange = rel >= 0 and rel < 2 * nCells * stepMs
bool eventBar = inRange and rel % stepMs == 0
bool cleanupBar = inRange and rel % stepMs == 30 * 60 * 1000
int cell = inRange ? (rel - rel % stepMs) / stepMs % nCells : -1

float lo = close * 0.5
float hi = close * 2.0

var int actedBar = -1
bool firstPass = bar_index != actedBar

if barstate.isconfirmed and firstPass and eventBar and strategy.position_size == 0
    actedBar := bar_index
    if cell == 0
        strategy.entry("E1", strategy.long, qty=1, comment="MM-LF-1")
        strategy.entry("E2", strategy.short, qty=1, comment="MM-LF-2")
    else if cell == 1
        strategy.entry("E1", strategy.short, qty=1, comment="MM-SF-1")
        strategy.entry("E2", strategy.long, qty=1, comment="MM-SF-2")
    else if cell == 2
        strategy.entry("E1", strategy.short, qty=1, comment="MS-SF-1")
        strategy.entry("E2", strategy.long, qty=1, stop=lo, comment="MS-SF-2")
    else if cell == 3
        strategy.entry("E1", strategy.short, qty=1, stop=hi, comment="SM-SF-1")
        strategy.entry("E2", strategy.long, qty=1, comment="SM-SF-2")
    else if cell == 4
        strategy.entry("E1", strategy.short, qty=1, limit=lo, comment="LM-SF-1")
        strategy.entry("E2", strategy.long, qty=1, comment="LM-SF-2")
    else if cell == 5
        strategy.entry("E1", strategy.long, qty=1, limit=hi, comment="LM-LF-1")
        strategy.entry("E2", strategy.short, qty=1, comment="LM-LF-2")
    else if cell == 6
        strategy.entry("E1", strategy.short, qty=2, comment="MM-SF-Q2-1")
        strategy.entry("E2", strategy.long, qty=3, comment="MM-SF-Q3-2")
    else if cell == 7
        strategy.entry("E1", strategy.short, qty=1, comment="ML-SF-1")
        strategy.entry("E2", strategy.long, qty=1, limit=hi, comment="ML-SF-2")

if barstate.isconfirmed and firstPass and cleanupBar and strategy.position_size != 0
    actedBar := bar_index
    strategy.cancel_all()
    strategy.close_all(comment="FLT")
