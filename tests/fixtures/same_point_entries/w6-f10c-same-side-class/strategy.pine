//@version=6
strategy("W6 F10c same-side legs at one open", overlay=true,
     initial_capital=1000000, pyramiding=2,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0,
     slippage=0, margin_long=100, margin_short=100,
     process_orders_on_close=false, calc_on_order_fills=false)

// Lane W6-ENG-FILL-ORDER, family F10. From flat, pyramiding 2: two
// strategy.entry calls of ONE side on one bar, both marketable at the next
// open, the second a different order kind with a different quantity. The
// quantity of each trade row shows which leg TradingView fills first (the
// cleanup closes the lots first in, first out). Cell names: E1 kind, E2
// kind (M market, S stop, L limit), then L (long) or S (short).

int t0 = timestamp("UTC", 2025, 4, 8, 0, 0)
int stepMs = 2 * 60 * 60 * 1000
int nCells = 8
int rel = time - t0
bool inRange = rel >= 0 and rel < 2 * nCells * stepMs
bool eventBar = inRange and rel % stepMs == 0
bool cleanupBar = inRange and rel % stepMs == 30 * 60 * 1000
int cell = inRange ? (rel - rel % stepMs) / stepMs % nCells : -1

float lo = close * 0.5
float hi = close * 2.0

if eventBar and strategy.position_size == 0
    if cell == 0
        strategy.entry("E1", strategy.long, qty=1, limit=hi, comment="LM-L-1")
        strategy.entry("E2", strategy.long, qty=2, comment="LM-L-2")
    else if cell == 1
        strategy.entry("E1", strategy.long, qty=1, limit=hi, comment="LS-L-1")
        strategy.entry("E2", strategy.long, qty=2, stop=lo, comment="LS-L-2")
    else if cell == 2
        strategy.entry("E1", strategy.long, qty=1, stop=lo, comment="SM-L-1")
        strategy.entry("E2", strategy.long, qty=2, comment="SM-L-2")
    else if cell == 3
        strategy.entry("E1", strategy.long, qty=1, comment="MS-L-1")
        strategy.entry("E2", strategy.long, qty=2, stop=lo, comment="MS-L-2")
    else if cell == 4
        strategy.entry("E1", strategy.short, qty=1, limit=lo, comment="LM-S-1")
        strategy.entry("E2", strategy.short, qty=2, comment="LM-S-2")
    else if cell == 5
        strategy.entry("E1", strategy.short, qty=1, limit=lo, comment="LS-S-1")
        strategy.entry("E2", strategy.short, qty=2, stop=hi, comment="LS-S-2")
    else if cell == 6
        strategy.entry("E1", strategy.short, qty=1, stop=hi, comment="SM-S-1")
        strategy.entry("E2", strategy.short, qty=2, comment="SM-S-2")
    else if cell == 7
        strategy.entry("E1", strategy.short, qty=1, comment="MS-S-1")
        strategy.entry("E2", strategy.short, qty=2, stop=hi, comment="MS-S-2")

if cleanupBar
    strategy.cancel_all()
    strategy.close_all(comment="FLT")
