//@version=6
strategy("W6 F10j opposite pair with a per-order commission", overlay=true,
     initial_capital=1000000, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=5,
     slippage=0, margin_long=100, margin_short=100,
     process_orders_on_close=false, calc_on_order_fills=false)

// Lane W6-ENG-FILL-ORDER, family F10, with a commission. From flat, two
// opposite strategy.entry calls on one bar, both marketable at the next open
// (a buy stop at half the close), so both fill at that one price. The
// Commission column shows how TradingView charges the later call's one
// transaction of both quantities across the two rows it books.

int t0 = timestamp("UTC", 2025, 4, 8, 0, 0)
int stepMs = 2 * 60 * 60 * 1000
int nCells = 4
int rel = time - t0
bool inRange = rel >= 0 and rel < 2 * nCells * stepMs
bool eventBar = inRange and rel % stepMs == 0
bool cleanupBar = inRange and rel % stepMs == 30 * 60 * 1000
int cell = inRange ? (rel - rel % stepMs) / stepMs % nCells : -1

float lo = close * 0.5

if eventBar and strategy.position_size == 0
    if cell == 0
        strategy.entry("E1", strategy.long, qty=1, comment="MM-LF-1")
        strategy.entry("E2", strategy.short, qty=1, comment="MM-LF-2")
    else if cell == 1
        strategy.entry("E1", strategy.short, qty=1, comment="MM-SF-1")
        strategy.entry("E2", strategy.long, qty=1, comment="MM-SF-2")
    else if cell == 2
        strategy.entry("E1", strategy.short, qty=1, comment="MS-SF-1")
        strategy.entry("E2", strategy.long, qty=1, stop=lo, comment="MS-SF-2")
    else if cell == 3
        strategy.entry("E1", strategy.short, qty=2, comment="MS-SF-Q2-1")
        strategy.entry("E2", strategy.long, qty=3, stop=lo, comment="MS-SF-Q3-2")

if cleanupBar
    strategy.cancel_all()
    strategy.close_all(comment="FLT")
