//@version=6
strategy("fifty static fractional FIFO closes", initial_capital=1000000, pyramiding=64, default_qty_type=strategy.cash, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.1, slippage=2, margin_long=0, margin_short=0)
if time == timestamp("UTC", 2025, 5, 1, 0, 0)
    strategy.entry("Seed", strategy.long, qty=0.0345)
    for ordinal = 0 to 49
        strategy.entry("E" + str.tostring(ordinal), strategy.long, qty=0.0138)
if time == timestamp("UTC", 2025, 5, 1, 0, 15)
    strategy.close("Seed", qty=0.0276)
