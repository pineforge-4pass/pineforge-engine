//@version=6
strategy("chained FIFO decimal boundary", initial_capital=1000000, pyramiding=10, margin_long=0, margin_short=0)
if time == timestamp("UTC", 2025, 5, 1, 0, 0)
    strategy.entry("First", strategy.long, qty=0.00127)
    strategy.entry("A", strategy.long, qty=0.00047)
    strategy.entry("B", strategy.long, qty=0.00057)
    strategy.entry("C", strategy.long, qty=0.00097)
    strategy.entry("D", strategy.long, qty=0.00117)
if time == timestamp("UTC", 2025, 5, 1, 0, 15)
    strategy.close("First")
    strategy.close("C")
if time == timestamp("UTC", 2025, 5, 1, 0, 45)
    strategy.close_all()
