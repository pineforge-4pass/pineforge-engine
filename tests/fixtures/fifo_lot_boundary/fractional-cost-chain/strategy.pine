//@version=6
strategy("fractional cash FIFO chain", initial_capital=1000000, pyramiding=10, default_qty_type=strategy.cash, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.1, slippage=2, margin_long=0, margin_short=0)
if time == timestamp("UTC", 2025, 5, 1, 0, 0)
    strategy.entry("A", strategy.long, qty=0.0414)
    strategy.entry("B", strategy.long, qty=0.0138)
    strategy.entry("B", strategy.long, qty=0.0138)
    strategy.entry("C", strategy.long, qty=0.0138)
    strategy.entry("C", strategy.long, qty=0.0138)
    strategy.entry("D", strategy.long, qty=0.0138)
if time == timestamp("UTC", 2025, 5, 1, 0, 15)
    strategy.close("A", qty=0.0345)
if time == timestamp("UTC", 2025, 5, 1, 0, 30)
    strategy.close("B")
    strategy.close("C")
if time == timestamp("UTC", 2025, 5, 1, 0, 45)
    strategy.close_all()
