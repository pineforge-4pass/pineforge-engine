//@version=6
strategy("G", process_orders_on_close=true, slippage=15, default_qty_type=strategy.percent_of_equity, default_qty_value=100)
h = request.security(syminfo.tickerid, "15", ta.sma(close, 4))
if ta.crossover(close, h)
    strategy.entry("L", strategy.long)
if ta.crossunder(close, h)
    strategy.entry("S", strategy.short)
