//@version=6
strategy("closing bracket boundaries", process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0)
strategy.entry("S", strategy.short)
strategy.exit("X", "S", stop=bar_index % 3 == 0 ? na : high, limit=bar_index % 3 == 1 ? low : na)
