//@version=6
strategy("w13-x1-close", overlay = true, initial_capital = 10000, margin_long = 100, margin_short = 100)
// Lane W13-ENG-MARGIN-OPP. From flat at the top of every hour a stop-entry
// short ten ticks under the close, sized at the close (qty = equity / close).
// On the bar it fills the script calls strategy.close_all() at that bar's close. Anything still open on a later bar is closed with strategy.close_all().
MODE = 1
var int st = 0
lvl = close - 10 * syminfo.mintick
if st == 0
    if strategy.position_size == 0 and minute(time) == 0
        strategy.entry("S", strategy.short, stop = lvl, qty = strategy.equity / close)
        st := 1
else if st == 1
    if strategy.position_size < 0
        if MODE == 1
            strategy.close_all(comment = "C0")
        else if MODE == 2
            strategy.cancel_all()
            strategy.close_all(comment = "C0")
        st := 2
    else
        strategy.cancel_all()
        st := 0
else
    if strategy.position_size != 0
        strategy.close_all(comment = "C1")
    else
        st := 0
