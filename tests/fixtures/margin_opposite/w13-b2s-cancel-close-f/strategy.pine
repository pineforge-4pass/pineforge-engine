//@version=6
strategy("w13-b2s-cancel-close", overlay = true, initial_capital = 10000, margin_long = 100, margin_short = 100, slippage = 1)
// Lane W13-ENG-MARGIN-OPP. From flat every 4 bars a stop-entry short one tick
// under the close, sized at the close (qty = equity / close). Slippage 1. On the bar it fills the script calls strategy.cancel_all() and then strategy.close_all().
// Anything still open on a later bar is closed with strategy.close_all().
MODE = 2
var int st = 0
lvl = close - syminfo.mintick
if st == 0
    if strategy.position_size == 0 and bar_index % 4 == 0
        strategy.entry("S", strategy.short, stop = lvl, qty = strategy.equity / close)
        st := 1
else if st == 1
    if strategy.position_size < 0
        if MODE == 1
            strategy.close_all(comment = "C0")
        else if MODE == 2
            strategy.cancel_all()
            strategy.close_all(comment = "C0")
        else if MODE == 4
            strategy.cancel_all()
        st := 2
    else
        strategy.cancel_all()
        st := 0
else
    if strategy.position_size != 0
        strategy.close_all(comment = "C1")
    else
        st := 0
