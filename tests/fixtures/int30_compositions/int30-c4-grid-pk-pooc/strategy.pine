//@version=6
// Lane INT30 composition probe (TAIL-B x TAIL-H): same-side MARKET adds one bar
// places on a held long whose newest lot, entry "L", carries a 50 % exit and a
// stop exit. TAIL-B's AS/AC/LF decide which adds fill and how the grown book
// is margin-called (first in, first out: the older seed lots, then "L");
// TAIL-H's PK decides what each exit of "L" holds once a call has shrunk it.
// Sized from the realized equity, rounded to 100, so that every cell's adds
// meet a call and a cent of an earlier cell's P&L does not move its sizing.
// BINANCE:ETHUSDT.P 15m, fixed UTC cells, 10000 of capital; every quantity is
// money / close, floored to 0.0001.
strategy("int30-c4-grid-pk-pooc", overlay=true, pyramiding=200, initial_capital=10000,
     margin_long=100, margin_short=100, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.06, slippage=3)

qOf(float money) => math.floor(money / close * 10000) / 10000

// Every 6 hours from 2025-04-02 00:00 UTC, forty cells of 24 bars. On a cell's
// first bar, flat, E = initial capital + net profit rounded to 100. Kind k = cell % 6: n = 1
// (k 0, 1), 3 (k 2, 3) or 10 (k 4, 5) lots, one per bar from the cell's first
// bar: n - 1 seeds S1 .. S(n-1) sharing 0.3 E, then "L" of 0.6 E (0.9 E when
// n = 1); on the bar after "L" the exits TP (50 %, limit 0.6 % above the
// close) and SL (stop 0.6 % below) from "L", TP first on even kinds, SL first
// on odd; two bars later three adds of 0.07 E each on one bar; flattened on
// the cell's 23rd bar.
int t0 = timestamp("UTC", 2025, 4, 2, 0, 0)
int step = 6 * 60 * 60 * 1000
int m15 = 15 * 60 * 1000
int rel = time - t0
bool inRange = rel >= 0 and rel < 40 * step
int barIn = inRange ? int(math.floor((rel % step) / m15)) : -1
int kind = inRange ? int(math.floor(rel / step)) % 6 : -1
int n = kind < 2 ? 1 : kind < 4 ? 3 : 10
var float E = na
if inRange and barIn == 0
    E := math.round((strategy.initial_capital + strategy.netprofit) / 100) * 100
if inRange and barIn < n - 1
    strategy.entry("S" + str.tostring(barIn + 1), strategy.long, qty=qOf(0.3 * E / (n - 1)), comment="S" + str.tostring(barIn + 1))
if inRange and barIn == n - 1
    strategy.entry("L", strategy.long, qty=qOf((n == 1 ? 0.9 : 0.6) * E), comment="L")
if inRange and barIn == n
    float tp = math.round_to_mintick(close * 1.006)
    float sl = math.round_to_mintick(close * 0.994)
    if kind % 2 == 0
        strategy.exit("TP", from_entry="L", qty_percent=50, limit=tp, comment="TP")
        strategy.exit("SL", from_entry="L", stop=sl, comment="SL")
    else
        strategy.exit("SL", from_entry="L", stop=sl, comment="SL")
        strategy.exit("TP", from_entry="L", qty_percent=50, limit=tp, comment="TP")
if inRange and barIn == n + 2
    for i = 1 to 3
        strategy.entry("A" + str.tostring(i), strategy.long, qty=qOf(0.07 * E), comment="A" + str.tostring(i))
if inRange and barIn == 22
    strategy.close_all(comment="cleanup")
