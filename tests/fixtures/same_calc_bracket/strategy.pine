//@version=6
strategy("Same calculation bracket", initial_capital=10000)
entryKind = input.string("market", "Entry kind")
exitTiming = input.string("same", "Exit timing")
direction = input.string("long", "Direction")
exitKind = input.string("stop", "Exit kind")
offset = input.float(0.0, "Price offset")
prearm = input.bool(true, "Pre-arm exit")
isLong = direction == "long"
entryLevel = 100.0 + offset
exitLevel = (exitKind == "stop" ? (isLong ? 95.0 : 105.0) : (isLong ? 105.0 : 95.0)) + offset
if bar_index == 1
    strategy.entry("ENTRY", isLong ? strategy.long : strategy.short, qty=2, stop=entryKind == "stop" ? entryLevel : na, limit=entryKind == "limit" ? entryLevel : na)
if bar_index == (exitTiming == "same" ? 1 : 2) or (prearm and exitTiming == "same" and bar_index == 0)
    strategy.exit("EXIT", "ENTRY", stop=exitKind == "stop" ? exitLevel : na, limit=exitKind == "limit" ? exitLevel : na)
