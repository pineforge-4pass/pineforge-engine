//@version=6
// Lane FIX-E1E2 synthetic probe (written for this lane; no scraped source).
// A flat pair of opposite fixed-quantity MARKET strategy.entry calls on one bar
// under process_orders_on_close, pyramiding 0 (declared), on a 60-minute
// chart. O pairs: each leg 80 % of equity (the pair's gross, 160 %, is over the
// equity); U pairs: each leg 30 %. LF: the long call first, SF: the short call
// first. Every position is closed with strategy.close_all two bars after its
// pair. Cells run on 2025-04-03 and 2025-04-04 (UTC) only.
strategy("fe2-pooc-pair", overlay=true, pyramiding=0, initial_capital=100000, process_orders_on_close=true)

active = time >= timestamp("UTC", 2025, 4, 3, 0, 0) and time < timestamp("UTC", 2025, 4, 5, 0, 0)
phase = hour(time, "UTC") % 12
flat = strategy.position_size == 0
qO = math.floor(0.8 * strategy.equity / close * 1000) / 1000
qU = math.floor(0.3 * strategy.equity / close * 1000) / 1000
if active and flat and phase == 1
    strategy.entry("L", strategy.long, qty=qO, comment="O-LF-L")
    strategy.entry("S", strategy.short, qty=qO, comment="O-LF-S")
if active and flat and phase == 4
    strategy.entry("S", strategy.short, qty=qO, comment="O-SF-S")
    strategy.entry("L", strategy.long, qty=qO, comment="O-SF-L")
if active and flat and phase == 7
    strategy.entry("L", strategy.long, qty=qU, comment="U-LF-L")
    strategy.entry("S", strategy.short, qty=qU, comment="U-LF-S")
if active and flat and phase == 10
    strategy.entry("S", strategy.short, qty=qU, comment="U-SF-S")
    strategy.entry("L", strategy.long, qty=qU, comment="U-SF-L")
if phase == 3 or phase == 6 or phase == 9 or phase == 0
    strategy.close_all(comment="X")
