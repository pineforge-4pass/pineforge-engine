//@version=6
strategy("W8B flip: same-id entry twice, fixed size", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1)

// Lane W8B-SIGSTATE-2. A short is open; on the flip bar the script calls
// strategy.entry for the long twice with the same id, the shape of a helper
// whose body repeats its entry call. Cell 1 flips after the price rose (the
// flip's own default size is below the short's), cell 2 after it fell (above).
// Fixed default of 1: the seeds name 2 (above the flip's size) and 0.5 (below).
if time == timestamp("UTC", 2025, 4, 8, 0, 15)
    strategy.entry("S1", strategy.short, qty=2, comment="S1 seed short")
if time == timestamp("UTC", 2025, 4, 8, 0, 30)
    strategy.entry("L1", strategy.long, comment="L1 flip long")
    strategy.entry("L1", strategy.long, comment="L1 flip long")
if time == timestamp("UTC", 2025, 4, 9, 0, 0)
    strategy.entry("S2", strategy.short, qty=0.5, comment="S2 seed short")
if time == timestamp("UTC", 2025, 4, 9, 0, 15)
    strategy.entry("L2", strategy.long, comment="L2 flip long")
    strategy.entry("L2", strategy.long, comment="L2 flip long")

cleanup = time == timestamp("UTC", 2025, 4, 8, 2, 0) or time == timestamp("UTC", 2025, 4, 9, 2, 0)
if cleanup
    strategy.cancel_all()
    strategy.close_all(comment="cleanup")
