// Lane W8A-SIGSTATE-1: the scope of a repeated same-id strategy.entry that
// reverses the position (CONTROL: every entry once). default_qty_value 10 percent of equity.
//   G 2025-04-08: long G1 (01:00); short G2 qty=10 once (03:00)
//   H 2025-04-08: short H1 (07:00); long H2 qty=1 once (09:00)
//   J 2025-04-08: long J1 (19:00); short J2 once with its exit, then short J3 with its exit (21:00)
//   K 2025-04-09: long K1 (07:00); short K2 as a market order only (09:00)
//   N 2025-04-09: long N1 (13:00); short N2 once (15:00)
// Each cell ends with strategy.cancel_all() and strategy.close_all() two hours later.
//@version=6
strategy("W8A dbl-entry scope3 single", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

at(int y, int mo, int d, int h, int mi) => time == timestamp("UTC", y, mo, d, h, mi)
after(int y, int mo, int d, int h, int mi) => time >= timestamp("UTC", y, mo, d, h, mi)

if at(2025, 4, 8, 1, 0)
    strategy.entry("G1", strategy.long)
if at(2025, 4, 8, 3, 0)
    strategy.entry("G2", strategy.short, qty=10)
if at(2025, 4, 8, 5, 0)
    strategy.cancel_all()
    strategy.close_all()

if at(2025, 4, 8, 7, 0)
    strategy.entry("H1", strategy.short)
if at(2025, 4, 8, 9, 0)
    strategy.entry("H2", strategy.long, qty=1)
if at(2025, 4, 8, 11, 0)
    strategy.cancel_all()
    strategy.close_all()

if at(2025, 4, 8, 19, 0)
    strategy.entry("J1", strategy.long)
if at(2025, 4, 8, 21, 0)
    strategy.entry("J2", strategy.short)
    strategy.exit("XJ2", "J2", stop=close * 1.08, limit=close * 0.92)
    strategy.entry("J3", strategy.short)
    strategy.exit("XJ3", "J3", stop=close * 1.08, limit=close * 0.92)
if at(2025, 4, 8, 23, 0)
    strategy.cancel_all()
    strategy.close_all()

if at(2025, 4, 9, 7, 0)
    strategy.entry("K1", strategy.long)
if at(2025, 4, 9, 9, 0)
    strategy.entry("K2", strategy.short)
if at(2025, 4, 9, 11, 0)
    strategy.cancel_all()
    strategy.close_all()

if at(2025, 4, 9, 13, 0)
    strategy.entry("N1", strategy.long)
if at(2025, 4, 9, 15, 0)
    strategy.entry("N2", strategy.short)
if at(2025, 4, 9, 17, 0)
    strategy.cancel_all()
    strategy.close_all()
