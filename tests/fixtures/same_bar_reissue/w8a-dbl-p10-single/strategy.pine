// Lane W8A-SIGSTATE-1: a strategy.entry called twice with one id on one bar
// while it reverses the position (CONTROL: every call once). default_qty_value 10 percent of equity.
//   A 2025-04-08: long A1 (01:00); short A2 once with its exit (03:00)
//   B 2025-04-08: short B1 (07:00); long B2 once, no exit (09:00)
//   C 2025-04-08: long C1 (13:00); short C2 qty=1 once (15:00)
//   E 2025-04-09: long E1 (01:00); short limit E2 placed once at 03:00
//   F 2025-04-09: flat; long F1 once (07:00)
// Each cell ends with strategy.cancel_all() and strategy.close_all() two hours later.
//@version=6
strategy("W8A dbl-entry p10 single", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

at(int y, int mo, int d, int h, int mi) => time == timestamp("UTC", y, mo, d, h, mi)
after(int y, int mo, int d, int h, int mi) => time >= timestamp("UTC", y, mo, d, h, mi)

if at(2025, 4, 8, 1, 0)
    strategy.entry("A1", strategy.long)
if at(2025, 4, 8, 3, 0)
    strategy.entry("A2", strategy.short)
    strategy.exit("XA2", "A2", stop=close * 1.05, limit=close * 0.95)
if at(2025, 4, 8, 5, 0)
    strategy.cancel_all()
    strategy.close_all()

if at(2025, 4, 8, 7, 0)
    strategy.entry("B1", strategy.short)
if at(2025, 4, 8, 9, 0)
    strategy.entry("B2", strategy.long)
if at(2025, 4, 8, 11, 0)
    strategy.cancel_all()
    strategy.close_all()

if at(2025, 4, 8, 13, 0)
    strategy.entry("C1", strategy.long)
if at(2025, 4, 8, 15, 0)
    strategy.entry("C2", strategy.short, qty=1)
if at(2025, 4, 8, 17, 0)
    strategy.cancel_all()
    strategy.close_all()

var float e_level = na
if at(2025, 4, 9, 1, 0)
    strategy.entry("E1", strategy.long)
if at(2025, 4, 9, 3, 0)
    e_level := close + 0.01
if at(2025, 4, 9, 3, 0)
    strategy.entry("E2", strategy.short, limit=e_level)
if at(2025, 4, 9, 5, 0)
    strategy.cancel_all()
    strategy.close_all()

if at(2025, 4, 9, 7, 0)
    strategy.entry("F1", strategy.long)
if at(2025, 4, 9, 9, 0)
    strategy.cancel_all()
    strategy.close_all()
