// Synthetic probe (lane W11-ENG-TIME-COLOR): color.t of a hex literal
// #FF0000xx for every alpha byte xx, four per exit comment.
strategy("w11 color alpha", overlay=true, initial_capital=100000000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=4, margin_long=0, margin_short=0)

var array<color> A = array.from(#FF000000, #FF000001, #FF000002, #FF000003, #FF000004, #FF000005, #FF000006, #FF000007, #FF000008, #FF000009, #FF00000A, #FF00000B, #FF00000C, #FF00000D, #FF00000E, #FF00000F, #FF000010, #FF000011, #FF000012, #FF000013, #FF000014, #FF000015, #FF000016, #FF000017, #FF000018, #FF000019, #FF00001A, #FF00001B, #FF00001C, #FF00001D, #FF00001E, #FF00001F, #FF000020, #FF000021, #FF000022, #FF000023, #FF000024, #FF000025, #FF000026, #FF000027, #FF000028, #FF000029, #FF00002A, #FF00002B, #FF00002C, #FF00002D, #FF00002E, #FF00002F, #FF000030, #FF000031, #FF000032, #FF000033, #FF000034, #FF000035, #FF000036, #FF000037, #FF000038, #FF000039, #FF00003A, #FF00003B, #FF00003C, #FF00003D, #FF00003E, #FF00003F, #FF000040, #FF000041, #FF000042, #FF000043, #FF000044, #FF000045, #FF000046, #FF000047, #FF000048, #FF000049, #FF00004A, #FF00004B, #FF00004C, #FF00004D, #FF00004E, #FF00004F, #FF000050, #FF000051, #FF000052, #FF000053, #FF000054, #FF000055, #FF000056, #FF000057, #FF000058, #FF000059, #FF00005A, #FF00005B, #FF00005C, #FF00005D, #FF00005E, #FF00005F, #FF000060, #FF000061, #FF000062, #FF000063, #FF000064, #FF000065, #FF000066, #FF000067, #FF000068, #FF000069, #FF00006A, #FF00006B, #FF00006C, #FF00006D, #FF00006E, #FF00006F, #FF000070, #FF000071, #FF000072, #FF000073, #FF000074, #FF000075, #FF000076, #FF000077, #FF000078, #FF000079, #FF00007A, #FF00007B, #FF00007C, #FF00007D, #FF00007E, #FF00007F, #FF000080, #FF000081, #FF000082, #FF000083, #FF000084, #FF000085, #FF000086, #FF000087, #FF000088, #FF000089, #FF00008A, #FF00008B, #FF00008C, #FF00008D, #FF00008E, #FF00008F, #FF000090, #FF000091, #FF000092, #FF000093, #FF000094, #FF000095, #FF000096, #FF000097, #FF000098, #FF000099, #FF00009A, #FF00009B, #FF00009C, #FF00009D, #FF00009E, #FF00009F, #FF0000A0, #FF0000A1, #FF0000A2, #FF0000A3, #FF0000A4, #FF0000A5, #FF0000A6, #FF0000A7, #FF0000A8, #FF0000A9, #FF0000AA, #FF0000AB, #FF0000AC, #FF0000AD, #FF0000AE, #FF0000AF, #FF0000B0, #FF0000B1, #FF0000B2, #FF0000B3, #FF0000B4, #FF0000B5, #FF0000B6, #FF0000B7, #FF0000B8, #FF0000B9, #FF0000BA, #FF0000BB, #FF0000BC, #FF0000BD, #FF0000BE, #FF0000BF, #FF0000C0, #FF0000C1, #FF0000C2, #FF0000C3, #FF0000C4, #FF0000C5, #FF0000C6, #FF0000C7, #FF0000C8, #FF0000C9, #FF0000CA, #FF0000CB, #FF0000CC, #FF0000CD, #FF0000CE, #FF0000CF, #FF0000D0, #FF0000D1, #FF0000D2, #FF0000D3, #FF0000D4, #FF0000D5, #FF0000D6, #FF0000D7, #FF0000D8, #FF0000D9, #FF0000DA, #FF0000DB, #FF0000DC, #FF0000DD, #FF0000DE, #FF0000DF, #FF0000E0, #FF0000E1, #FF0000E2, #FF0000E3, #FF0000E4, #FF0000E5, #FF0000E6, #FF0000E7, #FF0000E8, #FF0000E9, #FF0000EA, #FF0000EB, #FF0000EC, #FF0000ED, #FF0000EE, #FF0000EF, #FF0000F0, #FF0000F1, #FF0000F2, #FF0000F3, #FF0000F4, #FF0000F5, #FF0000F6, #FF0000F7, #FF0000F8, #FF0000F9, #FF0000FA, #FF0000FB, #FF0000FC, #FF0000FD, #FF0000FE, #FF0000FF)
j = (math.floor(bar_index / 2) % 64) * 4
sa = "a" + str.tostring(j) + ":" + str.tostring(color.t(array.get(A, j))) + "," + str.tostring(color.t(array.get(A, j + 1))) + "," + str.tostring(color.t(array.get(A, j + 2))) + "," + str.tostring(color.t(array.get(A, j + 3)))

if bar_index % 2 == 0
    strategy.entry("A", strategy.long)
else
    strategy.close("A", comment=sa)
