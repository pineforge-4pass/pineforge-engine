// R5 lane PAR-MARGIN-2 (M7, a limit opening under process_orders_on_close): a leveraged long LIMIT
// entry (margin 5, 14.17 x equity, limit 0.997 x close) placed on the signal bar 2025-04-02 20:00 UTC and
// filled on the next bar on its way down; that bar's low then breaches and its close recovers.
// process_orders_on_close ON. Timeout close 3 bars after the entry bar.
//@version=6
strategy("pm2-m7-poocl-0402-2000", overlay=true, initial_capital=1000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     margin_long=5, margin_short=5, commission_value=0, slippage=0,
     process_orders_on_close=true)
if time == timestamp("UTC", 2025, 4, 2, 20, 0) and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty = math.floor(14.17 * strategy.equity / close * 1000) / 1000, limit = math.round(close * 0.997, 2))
if strategy.position_size > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= 3
    strategy.close("L", comment="timeout")
