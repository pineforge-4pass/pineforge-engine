// R5 lane PAR-MARGIN-2 (M7, a SHORT limit opening): a short LIMIT entry (margin 5, 18.17 x equity,
// limit 1.003 x close) placed on the signal bar 2025-07-09 19:30 UTC and filled on the next bar on its
// way UP; that bar's high then breaches and its close recovers. Timeout close 3 bars after the entry bar.
//@version=6
strategy("pm2-m7-slim-0709-1930", overlay=true, initial_capital=1000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     margin_long=5, margin_short=5, commission_value=0, slippage=0,
     process_orders_on_close=false)
if time == timestamp("UTC", 2025, 7, 9, 19, 30) and strategy.position_size == 0
    strategy.entry("S", strategy.short, qty = math.floor(18.17 * strategy.equity / close * 1000) / 1000, limit = math.round(close * 1.003, 2))
if strategy.position_size < 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= 3
    strategy.close("S", comment="timeout")
