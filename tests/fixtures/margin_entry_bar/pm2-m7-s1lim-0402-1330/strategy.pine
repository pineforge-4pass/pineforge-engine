// R5 lane PAR-MARGIN-2 (M7, a SHORT limit opening): a short LIMIT entry (margin 100, 0.989 x equity,
// limit 1.003 x close) placed on the signal bar 2025-04-02 13:30 UTC and filled on the next bar on its
// way UP; that bar's high then breaches and its close recovers. Timeout close 3 bars after the entry bar.
//@version=6
strategy("pm2-m7-s1lim-0402-1330", overlay=true, initial_capital=1000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     margin_long=100, margin_short=100, commission_value=0, slippage=0,
     process_orders_on_close=false)
if time == timestamp("UTC", 2025, 4, 2, 13, 30) and strategy.position_size == 0
    strategy.entry("S", strategy.short, qty = math.floor(0.989 * strategy.equity / close * 1000) / 1000, limit = math.round(close * 1.003, 2))
if strategy.position_size < 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= 3
    strategy.close("S", comment="timeout")
