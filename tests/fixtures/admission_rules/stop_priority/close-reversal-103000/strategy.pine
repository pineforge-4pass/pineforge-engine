//@version=6
strategy("px-pin-close-reversal", initial_capital=103000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)
if time == timestamp("UTC", 2025, 5, 12, 18, 30)
    strategy.entry("Seed", strategy.short, qty=9694)
if time == timestamp("UTC", 2025, 5, 12, 19, 45)
    strategy.close("Seed")
    strategy.entry("Reverse", strategy.long)
if time == timestamp("UTC", 2025, 5, 13, 14, 0)
    strategy.close_all()
