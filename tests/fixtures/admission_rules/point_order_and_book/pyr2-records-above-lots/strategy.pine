//@version=6
strategy("n34-pyr2-records-above-lots", initial_capital=100000, pyramiding=3, process_orders_on_close=true, margin_long=100, margin_short=100)
if time == timestamp("UTC", 2025, 6, 3, 14, 0)
    strategy.entry("A", strategy.long, qty=1)
if time == timestamp("UTC", 2025, 6, 3, 14, 15)
    strategy.entry("B", strategy.long, qty=1)
if time == timestamp("UTC", 2025, 6, 3, 14, 30)
    strategy.entry("C", strategy.long, qty=2)
if time == timestamp("UTC", 2025, 6, 3, 14, 45)
    strategy.close("C")
if time == timestamp("UTC", 2025, 6, 3, 15, 0)
    strategy.entry("D", strategy.long, qty=1)
if time == timestamp("UTC", 2025, 6, 3, 15, 15)
    strategy.entry("E", strategy.long, qty=1)
if time == timestamp("UTC", 2025, 6, 3, 15, 45)
    strategy.close_all()
