//@version=6
// TAIL-D synthetic M3a: timeframe.change("D") on a day's first bar that a fill recalculates.
// Entry A at 23:45 UTC carries a tight stop that usually fills on the next day's first bar
// (00:00), so calc_on_order_fills recalculates that bar. A daily counter reset by
// timeframe.change("D") gates entry B at 12:00: B enters only when the reset ran.
strategy("td-m3a-tfchange-coof", overlay = true, calc_on_order_fills = true, default_qty_type = strategy.fixed, default_qty_value = 1, initial_capital = 10000000)
var int dayCount = 0
if timeframe.change("D")
    dayCount := 0
flat = strategy.position_size == 0
if flat and hour(time, "UTC") == 23 and minute(time) == 45
    strategy.entry("A", strategy.long)
    strategy.exit("XA", "A", stop = close - 1)
    dayCount := dayCount + 1
if not flat and hour(time, "UTC") == 11 and minute(time) == 45
    strategy.close_all(comment = "noon")
if flat and hour(time, "UTC") == 12 and minute(time) == 0 and dayCount == 0
    strategy.entry("B", strategy.long)
if strategy.position_size > 0 and strategy.opentrades.entry_id(0) == "B" and bar_index - strategy.opentrades.entry_bar_index(0) >= 2
    strategy.close("B", comment = "B done")
