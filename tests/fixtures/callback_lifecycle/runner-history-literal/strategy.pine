//@version=6
strategy("N6 independent runner-history-literal", overlay=true, initial_capital=10000000, calc_on_order_fills=true, process_orders_on_close=true, pyramiding=0, margin_long=100, margin_short=100, commission_value=0, slippage=0)
var float runnerStop = 11.80
var bool tookHalf = false
if time == timestamp("UTC",2025,10,14,18,30) and strategy.position_size == 0
    strategy.entry("ticket", strategy.short, qty=130)
if strategy.position_size < 0
    if math.abs(strategy.position_size) <= 65
        tookHalf := true
    if not tookHalf
        strategy.exit("first", "ticket", qty=65, limit=11.64, stop=11.80)
        strategy.exit("runner", "ticket", qty=65, stop=11.80)
    else
        runnerStop := math.min(runnerStop, strategy.position_avg_price)
        if high[1] > close
            runnerStop := math.min(runnerStop, 11.69)
        string sensor = "prior=" + str.tostring(high[1], "0.00000000") + " close=" + str.tostring(close, "0.00000000") + " stop=" + str.tostring(runnerStop, "0.00000000")
        strategy.exit("runner", "ticket", qty=65, stop=runnerStop, limit=11.00, comment=sensor)
if true and time == timestamp("UTC",2025,10,14,19,45) and strategy.position_size == 0
    strategy.entry("late long", strategy.long, qty=130)
if time >= timestamp("UTC",2025,10,16,19,30)
    strategy.close_all(comment="cleanup")
