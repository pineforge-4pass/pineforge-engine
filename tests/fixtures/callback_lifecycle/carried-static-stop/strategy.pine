//@version=6
strategy("N6 independent legal-static-stop", overlay=true, initial_capital=10000000, calc_on_order_fills=false, process_orders_on_close=false, pyramiding=0, margin_long=100, margin_short=100, commission_value=0.01, slippage=2)
