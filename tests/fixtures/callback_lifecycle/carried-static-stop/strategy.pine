    strategy.entry("ticket", strategy.short, qty=2272)
    strategy.exit("bracket", "ticket", limit=9.65, stop=10.4895)
if time >= timestamp("UTC",2025,5,23,19,30)
    strategy.close_all(comment="cleanup")
