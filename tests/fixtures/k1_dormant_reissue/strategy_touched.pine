//@version=6
strategy("CR150 K1 touched dormant reissue measurement", overlay=true, initial_capital=1000000000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         pyramiding=1, margin_long=100, margin_short=100,
         commission_type=strategy.commission.percent, commission_value=0, slippage=0,
         process_orders_on_close=false, calc_on_order_fills=false, close_entries_rule="FIFO")
// A fresh explicit-qty exit drains AFTER the callback's pair hold.
// Seed it far away on odd bars; on even bars replace the working seed with
// a near stop, then hold it through the public limit-entry/close pair.
// The following odd bar can touch and retire that held native request.
// No price tape is manufactured and no exit is cancelled. Near-stop touches
// depend on the ETH data. Eligible touch bars are odd bar_index >= 3.
if bar_index == 0
    strategy.entry("S", strategy.short, qty=1)
if bar_index >= 1 and strategy.position_size < 0
    strategy.exit("X", "S", stop=bar_index % 2 == 0 ? close + 2 * syminfo.mintick : 1000000000 + bar_index * 3 * syminfo.mintick, qty=0.5)
    strategy.entry("L", strategy.long, qty=1000000000, limit=syminfo.mintick)
    strategy.close("S")
