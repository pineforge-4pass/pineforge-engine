//@version=6
strategy("N6B coof-pp-limit-mid", overlay=true, initial_capital=10000000, calc_on_order_fills=true, process_orders_on_close=false, pyramiding=0, margin_long=100, margin_short=100, commission_value=0, slippage=0)
varip int k = 0
k += 1
var int v = 0
v += 1
string tag = "k" + str.tostring(k) + " v" + str.tostring(v) + " p" + str.tostring(strategy.position_size) + " n" + str.tostring(strategy.closedtrades)
if time == timestamp("UTC",2026,2,13,20,30)
    strategy.entry("L", strategy.long, qty=1, limit=255.70, comment="seed " + tag)
if time == timestamp("UTC",2026,2,13,20,45)
    if strategy.position_size > 0
        strategy.entry("S", strategy.short, qty=1, comment="S " + tag)
    else if strategy.position_size < 0
        strategy.entry("L", strategy.long, qty=1, comment="L " + tag)
if time >= timestamp("UTC",2026,2,17,18,0)
    strategy.close_all(comment="cleanup " + tag)
