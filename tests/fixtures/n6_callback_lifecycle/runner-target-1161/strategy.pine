//@version=6
strategy("N6B nirav-t2-1161", overlay=true, initial_capital=10000000, calc_on_order_fills=true, process_orders_on_close=true, pyramiding=0, margin_long=100, margin_short=100, commission_value=0, slippage=0)
float pv = (11.63 + 11.46 + 11.54) / 3.0
float rg = 11.63 - 11.46
float t1 = pv + rg * 0.618
float t2 = 11.61
var float runnerStop = 11.80
var bool tookHalf = false
if time == timestamp("UTC",2025,10,14,18,30) and strategy.position_size == 0
    strategy.entry("ticket", strategy.short, qty=130)
if strategy.position_size < 0
    if math.abs(strategy.position_size) <= 65
        tookHalf := true
    if not tookHalf
        strategy.exit("first", "ticket", qty=65, limit=t1, stop=11.80)
        strategy.exit("runner", "ticket", qty=65, stop=11.80)
    else
        runnerStop := math.min(runnerStop, strategy.position_avg_price)
        if high[1] > close
            runnerStop := math.min(runnerStop, high[1])
        string sensor = "t2=" + str.tostring(t2, "0.0000000000") + " stop=" + str.tostring(runnerStop, "0.00000000")
        strategy.exit("runner", "ticket", qty=65, stop=runnerStop, limit=t2, comment=sensor)
if time == timestamp("UTC",2025,10,14,19,45) and strategy.position_size == 0
    strategy.entry("late long", strategy.long, qty=130)
if time >= timestamp("UTC",2025,10,16,19,30)
    strategy.close_all(comment="cleanup")
