// Lane CG-W9-MISC: the magnifier-off twin of R5 lane MAG-INTRABAR's mi-fx-eth-15 (the same
// script with use_bar_magnifier=false). A market long every 2 chart bars while flat inside the
// window, bracketed at +-400 ticks from its fill: both legs often sit inside one chart bar.
//@version=6
strategy("w9mag-fx-eth-15-off", overlay=true, pyramiding=1, initial_capital=1000000,
     default_qty_type=strategy.fixed, default_qty_value=1, commission_value=0, slippage=0,
     use_bar_magnifier=false)
inWindow = time >= timestamp("UTC", 2026, 1, 30, 12, 0) and time < timestamp("UTC", 2026, 1, 31, 0, 0)
if strategy.position_size == 0 and bar_index % 2 == 0 and inWindow
    strategy.entry("L", strategy.long)
strategy.exit("X", "L", profit=400, loss=400)
