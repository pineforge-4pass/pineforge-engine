//@version=6
// TAIL-C synthetic: an exit stop placed already through by the recalculation of an entry that the recalculation of
// the bar's first open fill placed (a market newborn executed at that open, reversing the first fill).
// 8-hour UTC cycle; the first entry is placed at the hh:30 close and fills at the hh:45 open:
//   A (h%8==0): S at the open; its recalculation places L (reverses at the open); exit LX(stop) 5 through
//   B (h%8==2): as A with exit LX(stop, qty = 1)
//   C (h%8==4): L at the open; its recalculation places S (reverses); exit SX(stop) 5 through
//   D (h%8==6): L alone at the open; exit LX(stop) 5 through  (control: lane W4 cell LA)
strategy("tailc-1856-open-newborn", overlay = true, calc_on_order_fills = true, process_orders_on_close = false, default_qty_type = strategy.fixed, default_qty_value = 1, initial_capital = 1000000)
h = hour(time, "UTC")
m = minute(time)
c = h % 8
cell = c == 0 or c == 2 or c == 4 or c == 6
openedHere = strategy.opentrades > 0 and strategy.opentrades.entry_bar_index(0) == bar_index
if cell and m == 30
    if c == 0 or c == 2
        strategy.entry("S", strategy.short)
    else
        strategy.entry("L", strategy.long)
if cell and m == 45 and openedHere
    if (c == 0 or c == 2) and strategy.position_size < 0
        strategy.entry("L", strategy.long)
    if c == 4 and strategy.position_size > 0
        strategy.entry("S", strategy.short)
if strategy.position_size > 0 and strategy.opentrades.entry_id(0) == "L"
    if c == 2
        strategy.exit("LX", "L", stop = strategy.position_avg_price + 5, qty = 1)
    else if c != 4
        strategy.exit("LX", "L", stop = strategy.position_avg_price + 5)
if strategy.position_size < 0 and strategy.opentrades.entry_id(0) == "S" and c == 4
    strategy.exit("SX", "S", stop = strategy.position_avg_price - 5)
if not cell and m == 0 and strategy.position_size != 0
    strategy.close_all()
