//@version=6
strategy("PX stop equals closing high NSE",overlay=true,initial_capital=1000000,margin_long=0,margin_short=0,process_orders_on_close=true)
if time == timestamp("UTC",2025,4,8,6,30)
    strategy.entry("touch",strategy.long,qty=1,stop=high)
if time == timestamp("UTC",2025,4,8,9,45)
    strategy.close_all()
