//@version=6
strategy("RH prerange fills", overlay=true, initial_capital=1000000000000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     commission_value=0, slippage=0, process_orders_on_close=false)

// P_PRE: filled and closed before the range start (2025-04-01 00:00 UTC).
if time == timestamp("UTC", 2025, 3, 31, 19, 0)
    strategy.entry("P_PRE", strategy.long, qty=3)
if time == timestamp("UTC", 2025, 3, 31, 20, 0)
    strategy.close("P_PRE", comment="P_PRE_X")
// P_CARRY: filled before the range start, closed inside the range.
if time == timestamp("UTC", 2025, 3, 31, 21, 0)
    strategy.entry("P_CARRY", strategy.long, qty=4)
if time == timestamp("UTC", 2025, 4, 1, 3, 0)
    strategy.close("P_CARRY", comment="P_CARRY_X")
// IN: an ordinary in-range control.
if time == timestamp("UTC", 2025, 4, 2, 0, 0)
    strategy.entry("IN", strategy.long, qty=5)
if time == timestamp("UTC", 2025, 4, 2, 1, 0)
    strategy.close("IN", comment="IN_X")
