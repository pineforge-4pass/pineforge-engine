//@version=6
strategy("RH in-range preplaced", overlay=true, initial_capital=1000000000000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     commission_value=0, slippage=0, process_orders_on_close=false)

// S1: a long stop placed inside the range at 2025-04-01 01:00 UTC, above
// every high until 06:xx UTC -- TradingView's first fill comes from an
// order placed hours before the bar that precedes it.
if time == timestamp("UTC", 2025, 4, 1, 1, 0)
    strategy.entry("S1", strategy.long, qty=1, stop=1850.0)
if time == timestamp("UTC", 2025, 4, 1, 12, 0)
    strategy.close("S1", comment="S1_X")
// L1: a long limit placed at 13:00 UTC, below every low until 04-02 22:xx.
if time == timestamp("UTC", 2025, 4, 1, 13, 0)
    strategy.entry("L1", strategy.long, qty=2, limit=1790.0)
if time == timestamp("UTC", 2025, 4, 3, 12, 0)
    strategy.close("L1", comment="L1_X")
