// H-MEASURE (R5 wave H) row E19: the excursion of a calc_on_order_fills
// scratch. Every day (UTC) a long market entry from the 00:15 signal fills at
// the 00:30 open; the fill's own recalculation sees the position and closes
// it at once. Which part of the 00:30 bar belongs to that trade's
// favorable/adverse excursion?
//@version=6
strategy("HM E19 coof scratch", overlay=true, initial_capital=1000000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=1,
     commission_type=strategy.commission.percent, commission_value=0, slippage=0,
     process_orders_on_close=false, calc_on_order_fills=true,
     margin_long=100, margin_short=100)

m = hour * 60 + minute
if m == 15 and strategy.position_size == 0
    strategy.entry("L", strategy.long)
if strategy.position_size > 0
    strategy.close("L")
