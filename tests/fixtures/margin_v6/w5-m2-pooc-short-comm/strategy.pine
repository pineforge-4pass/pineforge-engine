//@version=6
strategy("W5 M2 POOC short open+extreme calls (comm 0.05 slip 1)", overlay=true, process_orders_on_close=true, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1)

// Lane W5-ENG-MARGIN-V6, mechanism M2. A 100%-of-equity SHORT filled at a
// signal close (process_orders_on_close) with a percent commission and one
// tick of slippage is short of margin at the next open already. Does
// TradingView call again at that bar's high, on the book the open call left?
if time == timestamp("UTC", 2025, 4, 10, 17, 0)
    strategy.entry("A", strategy.short, comment="A short")
if time == timestamp("UTC", 2025, 4, 2, 13, 30)
    strategy.entry("B", strategy.short, comment="B short")
if time == timestamp("UTC", 2025, 4, 22, 13, 15)
    strategy.entry("C", strategy.short, comment="C short")

cleanup = time == timestamp("UTC", 2025, 4, 10, 18, 30) or
     time == timestamp("UTC", 2025, 4, 2, 15, 0) or
     time == timestamp("UTC", 2025, 4, 22, 14, 45)
if cleanup
    strategy.cancel_all()
    strategy.close_all(comment="cleanup")
