//@version=6
strategy("W5 M2 POOC carried short call + close", overlay=true, process_orders_on_close=true, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1)

// Lane W5-ENG-MARGIN-V6, mechanism M2 (carried). A 100%-of-equity SHORT filled
// at the 12:00 close is called at the next open and high, and again at the
// 12:30 bar's high (1802). On that bar's close the script does: close.
// Does TradingView still call at the high before that close's own fill?
if time == timestamp("UTC", 2025, 4, 4, 12, 0)
    strategy.entry("S", strategy.short, comment="short")
if time == timestamp("UTC", 2025, 4, 4, 12, 30)
    strategy.close_all(comment="close at the called bar")
if time == timestamp("UTC", 2025, 4, 4, 13, 30)
    strategy.close_all(comment="cleanup")
