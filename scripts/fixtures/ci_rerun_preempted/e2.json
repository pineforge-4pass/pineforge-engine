  "workflow-at-head.yml": "jobs:\n  authz:\n    name: authz\n  changes:\n    needs: [authz]\n  preflight:\n    needs: [authz, changes]\n  preflight-slow:\n    needs: [authz, changes]\n  build:\n    name: build-shard (${{ matrix.platform.os }}, ${{ matrix.build_type }}, ${{ matrix.shard }}/4)\n    needs: [authz, changes]\n    strategy:\n      fail-fast: false\n      matrix:\n        platform:\n          - os: ubuntu-24.04\n        build_type: [Release]\n        shard: [1, 2, 3, 4]\n  build-debug:\n    name: build-shard (${{ matrix.platform.os }}, ${{ matrix.build_type }}, ${{ matrix.shard }}/2)\n    needs: [authz, changes]\n    strategy:\n      fail-fast: false\n      matrix:\n        platform:\n          - os: ubuntu-24.04\n        build_type: [Debug]\n        shard: [1, 2]\n  build-release-gate:\n    name: build (ubuntu-24.04, Release)\n    needs: [authz, changes, build]\n  build-debug-gate:\n    name: build (ubuntu-24.04, Debug)\n    needs: [authz, changes, build-debug]\n  build-arm:\n    name: build (ubuntu-24.04-arm, ${{ matrix.build_type }})\n    needs: [authz, changes]\n    strategy:\n      fail-fast: false\n      matrix:\n        build_type: [Release, Debug]\n  sanitizers:\n    name: sanitizers-shard (${{ matrix.shard }}/4)\n    needs: [authz, changes]\n    strategy:\n      fail-fast: false\n      matrix:\n        shard: [1, 2, 3, 4]\n  sanitizers-gate:\n    name: sanitizers\n    needs: [authz, changes, sanitizers]\n  kernel-only:\n    name: kernel-only-shard (${{ matrix.shard }}/2)\n    needs: [authz, changes]\n    strategy:\n      fail-fast: false\n      matrix:\n        shard: [1, 2]\n  kernel-only-gate:\n    name: kernel-only\n    needs: [authz, changes, kernel-only]\n  native-live:\n    needs: [authz, changes]\n    uses: ./.github/workflows/native-live.yml\n  corpus-parity-subset:\n    needs: [authz, changes]\n    uses: ./.github/workflows/corpus-parity.yml\n  corpus-parity:\n    needs: [authz, changes]\n    uses: ./.github/workflows/corpus-parity.yml\n  build-gate:\n    name: build\n    needs: [authz, changes, preflight, build, build-debug, build-release-gate, build-debug-gate, build-arm, sanitizers, sanitizers-gate, native-live, kernel-only, kernel-only-gate, corpus-parity-subset, preflight-slow, corpus-parity]\n",
